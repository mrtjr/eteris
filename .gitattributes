# Os scripts .cmd só funcionam com quebras de linha do Windows.
*.cmd text eol=crlf
*.bat text eol=crlf
# Motor com codecs: o script e os patches vão byte a byte como foram validados (LF; o SHA256 dos patches está no
# manifest.json do runtime, e o build.ps1 aplica-os com git apply), sem conversão de fins de linha.
build/cef-codecs/patches/*.patch -text
build/cef-codecs/build.ps1 -text
# CefSharp: o patch aplica-se com git apply ao codigo do CefSharp; sem conversao de fins de linha.
build/cefsharp/*.patch -text
# Lista BIP39 em português do kit de recuperação: vai byte a byte (o SHA-256 está fixado num teste), sem conversão de fins de linha.
src/Eteris.Sync/Crypto/bip39-pt.txt -text
