<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes que arrancam o Éteris compilado (TCO-01). Fora do Eteris.slnx: o dotnet test da raiz, o build-all.ps1 e o
       fluxo build não arrancam o navegador; correm com
         dotnet build src/Eteris.Browser -c Release
         dotnet test tests/Eteris.Browser.E2E.Tests -c Release
       Sem referência ao Eteris.Browser: o teste lança o executável, não o carrega. O nome acaba em .Tests para o
       Directory.Build.props o deixar fora do PathMap (o CallerFilePath tem de dar a raiz do repositório). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
