<UserControl x:Class="Eteris.Browser.TabRadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="920" MaxHeight="660"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}"
             KeyboardNavigation.TabNavigation="Cycle" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="RadarAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource FieldBorderBrush}"
                                Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadarChoice" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MaxDropDownHeight" Value="250" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" CornerRadius="6" Padding="8,6" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Chrome" CornerRadius="10" IsHitTestVisible="False"
                                    Background="{TemplateBinding Background}" BorderThickness="1"
                                    BorderBrush="{DynamicResource FieldBorderBrush}" Padding="9,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Grid.Column="1" Data="M 0,0 L 3,3 L 6,0" StrokeThickness="1.4"
                                          Stroke="{DynamicResource TextMutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="5">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" Padding="4"
                                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadarResult" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="11" Padding="10,7" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
            BorderThickness="1" CornerRadius="21" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource IrisBrush}" Margin="22,0" CornerRadius="0,0,3,3" />
            <Grid Grid.Row="1" Margin="19,15,19,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource IrisBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="#101420"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="RADAR DE ABAS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Encontra e organiza as tuas abas" Margin="0,2,0,0"
                               FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="DismissButton" Grid.Column="2" Style="{StaticResource RadarAction}"
                        Content="Fechar" ToolTip="Fechar o Radar (Esc)" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2" Margin="19,0,19,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.72*" />
                    <ColumnDefinition Width="0.72*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="QueryChrome" CornerRadius="11" BorderThickness="1" Margin="0,0,7,0"
                        Height="36" Background="{DynamicResource FieldBrush}" Padding="10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QueryBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox x:Name="QueryBox" Style="{DynamicResource BareTextBox}"
                                 AutomationProperties.Name="Procurar abas por título ou endereço" />
                        <TextBlock IsHitTestVisible="False" Text="Título ou endereço" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <ComboBox x:Name="Filters" Grid.Column="1" Margin="0,0,7,0" Style="{StaticResource RadarChoice}"
                          AutomationProperties.Name="Filtrar abas" />
                <ComboBox x:Name="Order" Grid.Column="2" Style="{StaticResource RadarChoice}"
                          AutomationProperties.Name="Ordenar abas" />
            </Grid>

            <Grid Grid.Row="3" Margin="19,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.42*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="6"
                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                    <ListBox x:Name="Results" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}" ItemContainerStyle="{StaticResource RadarResult}"
                             AutomationProperties.Name="Abas encontradas" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="33" Height="33" CornerRadius="10" Background="{Binding BadgeBrush}"
                                            Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Width="18" Height="18" Source="{Binding Image}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="2" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="11"
                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Height="132" CornerRadius="10" Background="{DynamicResource FieldBrush}"
                                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="PreviewPlaceholder" Margin="9" CornerRadius="7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#208B5CF6" Offset="0" />
                                                    <GradientStop Color="#2022D3EE" Offset="0.65" />
                                                    <GradientStop Color="#1634D399" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource IconFont}" FontSize="23"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Pré-visualização indisponível" FontSize="11" Margin="0,7,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="DetailsTitle" Margin="0,12,0,2" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Text="Escolhe uma aba" />
                                <TextBlock x:Name="DetailsAddress" Margin="0,0,0,3" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="DetailsState" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button x:Name="OpenButton" Content="Abrir" Style="{StaticResource RadarAction}"
                                    Background="{DynamicResource IrisBrush}" Foreground="#101420" FontWeight="SemiBold" Margin="0,0,5,5" />
                            <Button x:Name="PinButton" Content="Fixar" Style="{StaticResource RadarAction}" Margin="0,0,5,5" />
                            <Button x:Name="MuteButton" Content="Silenciar" Style="{StaticResource RadarAction}" Margin="0,0,5,5" />
                            <Button x:Name="SplitButton" Content="Abrir ao lado" Style="{StaticResource RadarAction}" Margin="0,0,5,5" />
                            <Button x:Name="CloseTabButton" Content="Fechar aba" Style="{StaticResource RadarAction}" Margin="0,0,0,5" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="19,9,19,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Summary" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="↑ ↓ mover · Enter abrir · Esc fechar"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
