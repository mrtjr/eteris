<Window x:Class="Eteris.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Active.Title, StringFormat={}{0} — Éteris, FallbackValue=Éteris}"
        Height="860" Width="1360" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FrameBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#1A1D27" />

        <Style x:Key="PaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="PaletteItem_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent" Padding="0,9,14,9" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" CornerRadius="1.5" Background="{StaticResource IrisBrush}" Visibility="Hidden" Margin="0,3" />
                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9" Background="#30354A">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border x:Name="Chip" Grid.Column="3" CornerRadius="7" Background="#262A38" Padding="8,3" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                                <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C3145" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCardTip" TargetType="ToolTip">
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Margin="10,0,10,20" Width="300" CornerRadius="14" Padding="14,12"
                                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                <TextBlock x:Name="Status" Text="{Binding StatusLine}" FontSize="11.5" Foreground="{StaticResource IrisBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusLine}" Value="">
                                <Setter TargetName="Status" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="TabItem_PreviewMouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="TabRoot" Height="36" Background="Transparent"
                              Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTipService.InitialShowDelay="450" ToolTipService.Placement="Bottom">
                            <Grid.ToolTip>
                                <ToolTip Style="{StaticResource TabCardTip}" />
                            </Grid.ToolTip>
                            <Border x:Name="Bg" CornerRadius="10,10,0,0" Background="Transparent" />
                            <Border x:Name="Glow" Height="2" VerticalAlignment="Top" Margin="14,0" CornerRadius="1"
                                    Background="{StaticResource IrisBrush}" Visibility="Collapsed" />
                            <Grid x:Name="TabContent" Margin="12,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16">
                                    <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Grid x:Name="Globe" Visibility="Collapsed">
                                        <Border x:Name="Badge" CornerRadius="5" Background="{Binding MonogramBrush}">
                                            <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                        </Border>
                                        <TextBlock x:Name="GlobeGlyph" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Ellipse x:Name="NewTabIcon" Width="13" Height="13" Stroke="{StaticResource IrisBrush}"
                                             StrokeThickness="2.5" Visibility="Collapsed" />
                                    <Path x:Name="Spinner" Style="{StaticResource SpinnerArc}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" Margin="8,0,4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="TabAudio" Content="{Binding AudioGlyph}" Style="{StaticResource TabCloseButton}"
                                            FontSize="11" Click="TabAudio_Click" ToolTip="Silenciar / reativar o som desta aba"
                                            Visibility="Collapsed" />
                                    <Button x:Name="TabClose" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}"
                                            Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Monogram}" Value="{x:Null}">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="GlobeGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNewTab}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAudible}" Value="True">
                                <Setter TargetName="TabAudio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="TabAudio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="TabRoot" Property="Width" Value="44" />
                                <Setter TargetName="TabContent" Property="Margin" Value="14,0,0,0" />
                                <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Glow" Property="Margin" Value="10,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                <Setter TargetName="TabTitle" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Favicon" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Globe" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ChromeSurfaceBrush}" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="TabItem_PreviewMouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Row" Height="38" Margin="6,1" Background="Transparent" Cursor="Hand" ToolTipService.InitialShowDelay="450" ToolTipService.Placement="Bottom">
                            <Grid.ToolTip>
                                <ToolTip Style="{StaticResource TabCardTip}" />
                            </Grid.ToolTip>
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="1.5"
                                    Background="{StaticResource IrisBrush}" Visibility="Hidden" />
                            <Grid Margin="13,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16">
                                    <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="Badge" CornerRadius="5" Background="{Binding MonogramBrush}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                    </Border>
                                    <TextBlock x:Name="SideGlobe" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="NewTabIcon" Width="13" Height="13" Stroke="{StaticResource IrisBrush}"
                                             StrokeThickness="2.5" Visibility="Collapsed" />
                                    <Path x:Name="Spinner" Style="{StaticResource SpinnerArc}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" Margin="10,0,4,0" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="Audio" Content="{Binding AudioGlyph}" Style="{StaticResource TabCloseButton}"
                                            FontSize="11" Click="TabAudio_Click" Visibility="Collapsed" />
                                    <Button x:Name="Close" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}"
                                            Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)" Visibility="Hidden" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Favicon}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Monogram}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideGlobe" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsNewTab}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideGlobe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAudible}" Value="True">
                                <Setter TargetName="Audio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Audio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                <Setter TargetName="Title" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Favicon" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Badge" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF" />
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2F45" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SideCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Suggestion_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="0,7,12,7" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" CornerRadius="1.5" Background="{StaticResource IrisBrush}" Visibility="Hidden" Margin="0,2" />
                                <TextBlock x:Name="Icon" Grid.Column="1" Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <Border x:Name="Mono" Grid.Column="1" Width="22" Height="22" CornerRadius="7"
                                        Background="{Binding MonogramColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Monogram}" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Text}" FontSize="14" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail, StringFormat={} — {0}}" FontSize="13"
                                           Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Monogram}" Value="{x:Null}">
                                <Setter TargetName="Mono" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Search">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE721;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Navigate">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE71B;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Bookmark">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource IrisBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Tab">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8AB;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Answer">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8EF;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource IrisBrush}" />
                                <Setter TargetName="Label" Property="FontSize" Value="17" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C3145" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OmniboxFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource IrisBrush}" />
                    <Setter Property="Background" Value="#0B0D13" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReloadButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE72C;" />
            <Setter Property="ToolTip" Value="Recarregar (F5)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active.IsLoading}" Value="True">
                    <Setter Property="Content" Value="&#xE711;" />
                    <Setter Property="ToolTip" Value="Parar (Esc)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="AuroraBrush" StartPoint="0,0" EndPoint="0.5,0" SpreadMethod="Repeat">
            <LinearGradientBrush.RelativeTransform>
                <TranslateTransform />
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#008B5CF6" Offset="0" />
            <GradientStop Color="#8B5CF6" Offset="0.2" />
            <GradientStop Color="#22D3EE" Offset="0.45" />
            <GradientStop Color="#34D399" Offset="0.7" />
            <GradientStop Color="#F472B6" Offset="0.9" />
            <GradientStop Color="#008B5CF6" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="42" />
                <RowDefinition x:Name="ToolbarRow" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título com abas -->
            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="TabStripHost" SizeChanged="TabStripHost_SizeChanged">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Grid Width="40" Height="36" ToolTip="Éteris">
                            <Ellipse Width="18" Height="18" Stroke="{StaticResource IrisBrush}" StrokeThickness="3" />
                            <Ellipse Width="5" Height="5" Fill="{StaticResource TextBrush}" />
                        </Grid>
                        <Border x:Name="PrivateBadge" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,3"
                                CornerRadius="10" Padding="10,3" Background="#3B1D6E" BorderBrush="#7C3AED" BorderThickness="1"
                                ToolTip="Nada desta janela fica no histórico, nos cookies nem na cache">
                            <TextBlock Text="Privada" FontSize="11.5" FontWeight="SemiBold" Foreground="#E9D5FF" />
                        </Border>
                        <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Active}"
                                 PreviewMouseMove="TabList_PreviewMouseMove" PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp"
                                 ItemContainerStyle="{StaticResource TabItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                Margin="6,0,0,3" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar" />
                </StackPanel>
            </Grid>

            <!-- Barra de ferramentas -->
            <Border x:Name="Toolbar" Grid.Row="1" Background="{StaticResource ChromeSurfaceBrush}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Com abas verticais a barra de título desaparece: os botões da janela vêm para aqui -->
                    <StackPanel x:Name="ToolbarCaption" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                                Height="34" Margin="8,0,-8,0" Visibility="Collapsed">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" />
                        <Button x:Name="MaximizeButton2" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Click="Back_Click"
                                IsEnabled="{Binding Active.CanGoBack}" ToolTip="Voltar (Alt+←)" />
                        <Button Content="&#xE72A;" Style="{StaticResource IconButton}" Click="Forward_Click"
                                IsEnabled="{Binding Active.CanGoForward}" ToolTip="Avançar (Alt+→)" />
                        <Button Style="{StaticResource ReloadButton}" Click="Reload_Click" />
                    </StackPanel>

                    <Border x:Name="OmniboxFrame" Grid.Column="1" Style="{StaticResource OmniboxFrame}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Height="36" CornerRadius="18" BorderThickness="1.5" Margin="8,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SiteInfoButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Margin="6,0,2,0" Click="SiteInfo_Click">
                                <TextBlock x:Name="SiteIcon" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Button>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReaderButton" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,2,0"
                                        Click="Reader_Click" ToolTip="Modo de leitura (F9)"
                                        Visibility="{Binding Active.IsReaderable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE736;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <Button x:Name="ZoomBadge" Visibility="Collapsed" Click="ZoomBadge_Click" Cursor="Hand"
                                        ToolTip="Repor o zoom deste site (Ctrl+0)" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="#2A2F45"
                                                    BorderBrush="{StaticResource IrisBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{StaticResource IrisBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#3A4060" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="ZoomBadgeText" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
                                </Button>
                                                            <Button x:Name="StarButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Margin="0,0,4,0" Click="Star_Click" ToolTip="Adicionar aos favoritos (Ctrl+D)" Visibility="Collapsed">
                                <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                            </Button>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                <TextBox x:Name="Omnibox" Style="{StaticResource BareTextBox}"
                                         PreviewKeyDown="Omnibox_PreviewKeyDown" GotKeyboardFocus="Omnibox_GotKeyboardFocus"
                                         TextChanged="Omnibox_TextChanged"
                                         PreviewMouseLeftButtonDown="Omnibox_PreviewMouseLeftButtonDown"
                                         LostKeyboardFocus="Omnibox_LostKeyboardFocus" />
                                <TextBlock x:Name="OmniboxDisplay" IsHitTestVisible="False" VerticalAlignment="Center"
                                           FontSize="14" Margin="2,0,0,1" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="DisplayHost" Foreground="{StaticResource TextBrush}" /><Run x:Name="DisplayRest" Foreground="{StaticResource TextFaintBrush}" />
                                </TextBlock>
                                <TextBlock x:Name="OmniboxPlaceholder" IsHitTestVisible="False" VerticalAlignment="Center"
                                           FontSize="14" Margin="2,0,0,1" Foreground="{StaticResource TextFaintBrush}"
                                           Text="Pesquisar ou escrever um endereço" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Informação do site (cadeado) -->
                    <Popup x:Name="SiteInfoPopup" PlacementTarget="{Binding ElementName=SiteInfoButton}" Placement="Bottom"
                           HorizontalOffset="-20" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="14,0,14,24" Width="360" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Ellipse x:Name="SiteInfoHalo" Fill="#3DDC97" />
                                        <TextBlock x:Name="SiteInfoGlyph" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   Foreground="#0B0D13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SiteInfoTitle" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SiteInfoHost" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SiteInfoDetail" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18" />

                                <StackPanel x:Name="SiteInfoSiteSection">
                                    <Border Height="1" Background="{StaticResource FieldBorderBrush}" Margin="0,16,0,12" />
                                    <TextBlock Text="PERMISSÕES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="SiteInfoNoPermissions" Text="Este site não tem permissões guardadas."
                                               FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl x:Name="SiteInfoPermissions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" CornerRadius="8" Background="{Binding StateBrush}" Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="#0B0D13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="&#xE894;" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                            FontSize="11" Margin="6,0,0,0" ToolTip="Esquecer (voltar a perguntar)"
                                                            Tag="{Binding Kind}" Click="SiteInfoForget_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{StaticResource FieldBorderBrush}" Margin="0,14,0,12" />
                                    <TextBlock x:Name="SiteInfoTrackers" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                    <Button x:Name="SiteInfoClear" Content="Apagar cookies e dados deste site" Style="{StaticResource PillButton}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="SiteInfoClear_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=OmniboxFrame}" Placement="Bottom"
                           HorizontalOffset="-14" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True"
                           PopupAnimation="Fade" Focusable="False">
                        <Border Margin="14,0,14,24" Width="{Binding ActualWidth, ElementName=OmniboxFrame}"
                                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <ListBox x:Name="SuggestionList" Focusable="False" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </Border>
                    </Popup>

                    <StackPanel x:Name="ToolbarRight" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="UpdatePill" Visibility="Collapsed" Click="UpdatePill_Click" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Fecha e reabre o Éteris com a nova versão (as abas são mantidas)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pill" CornerRadius="15" Height="30" Padding="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#C4B5FD" Offset="0" />
                                                <GradientStop Color="#67E8F9" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#0B0D13"
                                                       VerticalAlignment="Center" Margin="0,1,8,0" />
                                            <TextBlock x:Name="UpdatePillText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#0B0D13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Grid x:Name="DownloadsHost" Visibility="Collapsed" Margin="0,0,4,0">
                            <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" Click="Downloads_Click"
                                    ToolTip="Transferências (Ctrl+J)">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                            </Button>
                            <Ellipse Width="30" Height="30" Stroke="#2B3042" StrokeThickness="2" IsHitTestVisible="False"
                                     x:Name="DownloadsTrack" Visibility="Collapsed" />
                            <Path x:Name="DownloadsRing" Stroke="{StaticResource IrisBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                  Width="34" Height="34" />
                        </Grid>
                        <Grid>
                            <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" Click="Shield_Click"
                                    ToolTip="Escudo do Éteris">
                                <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                            </Button>
                            <Border x:Name="ShieldBadge" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,0,-3,0" MinWidth="17" Height="16" CornerRadius="8" Padding="4,0"
                                    Background="{StaticResource IrisBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ShieldCount" FontSize="10" FontWeight="Bold" Foreground="#0B0D13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Border>
                        </Grid>
                        <Button x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Menu_Click"
                                ToolTip="Comandos (Ctrl+K)" />
                    </StackPanel>

                    <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom"
                           HorizontalOffset="-322" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="14,0,14,24" Width="370" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="10,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="10,0,6,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                            Content="&#xE838;" Click="OpenDownloadsFolder_Click" ToolTip="Abrir a pasta Transferências" />
                                    <TextBlock Text="Transferências" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="DownloadsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="12" Padding="10,8" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="DownloadRow_Click" ToolTip="{Binding FullPath}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30" Height="30" CornerRadius="9" Background="#30354A">
                                                        <TextBlock x:Name="Glyph" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                                                        <ProgressBar x:Name="Bar" Height="3" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay}">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid>
                                                                        <Border x:Name="PART_Track" CornerRadius="1.5" Background="#2B3042" />
                                                                        <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left"
                                                                                Background="{StaticResource IrisBrush}" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                    <Button x:Name="Cancel" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            FontSize="10" Content="&#xE711;" Click="CancelDownload_Click" ToolTip="Cancelar" />
                                                    <Button x:Name="Folder" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            FontSize="12" Content="&#xE838;" Click="ShowDownloadInFolder_Click"
                                                            ToolTip="Mostrar na pasta" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Cancel" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Folder" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                                    <Setter TargetName="Folder" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="ShieldPopup" PlacementTarget="{Binding ElementName=ShieldButton}" Placement="Bottom"
                           HorizontalOffset="-322" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="14,0,14,24" Width="350" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Ellipse x:Name="ShieldHalo" Fill="{StaticResource IrisBrush}" Opacity="0.9" />
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#0B0D13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ShieldTitle" Text="Escudo ativo" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ShieldSite" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShieldToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center" Click="ShieldToggle_Click" ToolTip="Proteção neste site" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource FieldBorderBrush}" Margin="0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ShieldBigCount" FontSize="40" FontWeight="Light" Foreground="{StaticResource IrisBrush}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="ShieldCountLabel" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="10,0,0,9" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="220" />
                                </StackPanel>

                                <ItemsControl x:Name="ShieldHosts" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" CornerRadius="8" Background="#30354A" Padding="7,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource FieldBorderBrush}" Margin="0,14,0,12" />

                                <TextBlock x:Name="ShieldCheckHeaders" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckCookies" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckWebRtc" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldSession" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Página: flutua sobre a superfície, com cantos arredondados -->
            <!-- Abas verticais -->
            <Border x:Name="SideBar" Grid.Row="2" Width="248" HorizontalAlignment="Left" Visibility="Collapsed"
                    Background="{StaticResource ChromeSurfaceBrush}" Padding="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" Cursor="Hand" Margin="6,2,6,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Height="38" CornerRadius="10" Background="Transparent" Padding="13,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" Width="16"
                                                   Foreground="{StaticResource IrisBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="L" Text="Nova aba" FontSize="13" Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#12FFFFFF" />
                                        <Setter TargetName="L" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SideCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="L" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="SideCollapseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="10,4,0,0"
                            Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12"
                            Content="&#xE76B;" Click="SideCollapse_Click" ToolTip="Encolher a barra de abas" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="SideTabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Active}"
                                 ItemContainerStyle="{StaticResource SideTabItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="PageFrame" Grid.Row="2" Background="{StaticResource ChromeSurfaceBrush}" Padding="6,0,6,6">
                <Grid x:Name="BrowserHost" Background="#FFFFFF" SizeChanged="BrowserHost_SizeChanged" PreviewMouseWheel="BrowserHost_PreviewMouseWheel">
                    <Rectangle x:Name="AuroraBar" Height="3" VerticalAlignment="Top" Panel.ZIndex="10"
                               Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Pedido de permissão de um site -->
            <Border x:Name="PermissionBar" Grid.Row="2" Panel.ZIndex="45" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="20,10,0,0" CornerRadius="18" Padding="18,14" MaxWidth="460"
                    Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                    BorderThickness="1" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="38" VerticalAlignment="Top">
                            <Ellipse Fill="{StaticResource IrisBrush}" />
                            <TextBlock x:Name="PermissionGlyph" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#0B0D13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="PermissionText" TextWrapping="Wrap" MaxWidth="360" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <CheckBox x:Name="PermissionRemember" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Lembrar neste site" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button x:Name="PermissionAllowButton" DockPanel.Dock="Right" Content="Permitir"
                                Style="{StaticResource PrimaryPillButton}" Click="PermissionAllow_Click" Margin="8,0,0,0" />
                        <Button x:Name="PermissionDenyButton" DockPanel.Dock="Right" Content="Bloquear"
                                Style="{StaticResource PillButton}" Click="PermissionDeny_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Procurar na página -->
            <Border x:Name="FindBar" Grid.Row="2" Panel.ZIndex="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,24,0" CornerRadius="20" Padding="14,4,6,4" Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource IrisBrush}" BorderThickness="1.5" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                    <Grid Width="220">
                        <TextBox x:Name="FindInput" Style="{StaticResource BareTextBox}" FontSize="13.5"
                                 TextChanged="FindInput_TextChanged" PreviewKeyDown="FindInput_PreviewKeyDown" />
                        <TextBlock x:Name="FindPlaceholder" Text="Procurar na página" IsHitTestVisible="False" FontSize="13.5"
                                   Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" />
                    </Grid>
                    <TextBlock x:Name="FindCount" FontSize="12" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Margin="8,0" />
                    <Button x:Name="FindPrevButton" Content="&#xE70E;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="11" Click="FindPrev_Click" ToolTip="Anterior (Shift+Enter)" />
                    <Button x:Name="FindNextButton" Content="&#xE70D;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="11" Click="FindNext_Click" ToolTip="Seguinte (Enter)" />
                    <Button x:Name="FindCloseButton" Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="10" Click="FindClose_Click" ToolTip="Fechar (Esc)" />
                </StackPanel>
            </Border>

            <!-- Aviso do modo foco -->
            <Border x:Name="FocusToast" Grid.Row="2" Panel.ZIndex="50" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,18,0,0" CornerRadius="16" Padding="16,8" Background="#E61A1D27" IsHitTestVisible="False"
                    BorderBrush="{StaticResource IrisBrush}" BorderThickness="1" Opacity="0">
                <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}">
                    Modo foco — prima <Bold>F11</Bold> ou <Bold>Ctrl+K</Bold> para voltar
                </TextBlock>
            </Border>

            <!-- Aviso genérico (copiado, guardado, ...) -->
            <Border x:Name="Toast" Grid.Row="2" Panel.ZIndex="55" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" CornerRadius="18" Padding="18,9" Background="#F21A1D27" IsHitTestVisible="False"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,10,0"
                               Foreground="{StaticResource IrisBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Paleta de comandos -->
            <Grid x:Name="PaletteOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Rectangle Fill="#99050710" MouseLeftButtonDown="PaletteBackdrop_MouseLeftButtonDown" />
                <Border x:Name="PaletteCard" Width="680" VerticalAlignment="Top" Margin="0,92,0,0" CornerRadius="22"
                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource IrisBrush}"
                        BorderThickness="1.5" RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PaletteScale" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.6" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Height="62" Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBox x:Name="PaletteInput" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="18"
                                     TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                            <TextBlock x:Name="PalettePlaceholder" Grid.Column="1" IsHitTestVisible="False" FontSize="18"
                                       Margin="2,0,0,1" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"
                                       Text="Escreva um comando, o nome de uma aba ou um site…" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource FieldBorderBrush}" />
                        <ListBox x:Name="PaletteList" Margin="8,8,8,4" MaxHeight="452" Focusable="False"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PaletteItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                        <TextBlock Margin="22,4,22,14" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   Text="↑ ↓ navegar   ·   Enter executar   ·   Esc fechar" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
