<Window x:Class="Eteris.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        Title="Éteris" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="AddressBox" Grid.Row="0" Margin="6" Padding="6,4" FontSize="14"
                 KeyDown="AddressBox_KeyDown" />
        <cef:ChromiumWebBrowser x:Name="Browser" Grid.Row="1" Address="https://pt.wikipedia.org"
                                AddressChanged="Browser_AddressChanged"
                                TitleChanged="Browser_TitleChanged" />
    </Grid>
</Window>
