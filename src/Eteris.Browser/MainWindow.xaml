<Window x:Class="Eteris.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Active.Title, StringFormat={}{0} — Éteris, FallbackValue=Éteris}"
        Height="860" Width="1360" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FrameBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="36" Background="Transparent"
                              Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="{Binding Title}">
                            <Border x:Name="Bg" CornerRadius="10,10,0,0" Background="Transparent" />
                            <Border x:Name="Glow" Height="2" VerticalAlignment="Top" Margin="14,0" CornerRadius="1"
                                    Background="{StaticResource IrisBrush}" Visibility="Collapsed" />
                            <Grid Margin="12,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16">
                                    <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Grid x:Name="Globe" Visibility="Collapsed">
                                        <Border x:Name="Badge" CornerRadius="5" Background="{Binding MonogramBrush}">
                                            <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                        </Border>
                                        <TextBlock x:Name="GlobeGlyph" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Path x:Name="Spinner" Style="{StaticResource SpinnerArc}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" Margin="8,0,4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}"
                                        Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Monogram}" Value="{x:Null}">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="GlobeGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OmniboxFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource IrisBrush}" />
                    <Setter Property="Background" Value="#0B0D13" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReloadButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE72C;" />
            <Setter Property="ToolTip" Value="Recarregar (F5)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active.IsLoading}" Value="True">
                    <Setter Property="Content" Value="&#xE711;" />
                    <Setter Property="ToolTip" Value="Parar (Esc)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="AuroraBrush" StartPoint="0,0" EndPoint="0.5,0" SpreadMethod="Repeat">
            <LinearGradientBrush.RelativeTransform>
                <TranslateTransform />
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#008B5CF6" Offset="0" />
            <GradientStop Color="#8B5CF6" Offset="0.2" />
            <GradientStop Color="#22D3EE" Offset="0.45" />
            <GradientStop Color="#34D399" Offset="0.7" />
            <GradientStop Color="#F472B6" Offset="0.9" />
            <GradientStop Color="#008B5CF6" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título com abas -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="TabStripHost" SizeChanged="TabStripHost_SizeChanged">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Grid Width="40" Height="36" ToolTip="Éteris">
                            <Ellipse Width="18" Height="18" Stroke="{StaticResource IrisBrush}" StrokeThickness="3" />
                            <Ellipse Width="5" Height="5" Fill="{StaticResource TextBrush}" />
                        </Grid>
                        <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Active}"
                                 ItemContainerStyle="{StaticResource TabItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                Margin="6,0,0,3" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar" />
                </StackPanel>
            </Grid>

            <!-- Barra de ferramentas -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Click="Back_Click"
                                IsEnabled="{Binding Active.CanGoBack}" ToolTip="Voltar (Alt+←)" />
                        <Button Content="&#xE72A;" Style="{StaticResource IconButton}" Click="Forward_Click"
                                IsEnabled="{Binding Active.CanGoForward}" ToolTip="Avançar (Alt+→)" />
                        <Button Style="{StaticResource ReloadButton}" Click="Reload_Click" />
                    </StackPanel>

                    <Border x:Name="OmniboxFrame" Grid.Column="1" Style="{StaticResource OmniboxFrame}"
                            Height="36" CornerRadius="18" BorderThickness="1.5" Margin="8,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SiteIcon" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="16,0,10,0" VerticalAlignment="Center" />
                            <TextBox x:Name="Omnibox" Grid.Column="1" Style="{StaticResource BareTextBox}" Margin="0,0,16,0"
                                     KeyDown="Omnibox_KeyDown" GotKeyboardFocus="Omnibox_GotKeyboardFocus"
                                     TextChanged="Omnibox_TextChanged"
                                     PreviewMouseLeftButtonDown="Omnibox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="Omnibox_LostKeyboardFocus" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="ToolbarRight" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Página: flutua sobre a superfície, com cantos arredondados -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="6,0,6,6">
                <Grid x:Name="BrowserHost" Background="#FFFFFF" SizeChanged="BrowserHost_SizeChanged">
                    <Rectangle x:Name="AuroraBar" Height="3" VerticalAlignment="Top" Panel.ZIndex="10"
                               Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
