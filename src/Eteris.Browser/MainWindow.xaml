<Window x:Class="Eteris.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sidebar="clr-namespace:Eteris.Browser.Sidebar"
        Title="{Binding Active.Title, StringFormat={}{0} — Éteris, FallbackValue=Éteris}"
        Height="860" Width="1360" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FrameBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#1A1D27" />

        <!-- Chip de um Espaço (barra de título e barra lateral): bolinha da cor, emoji ou inicial, o atual com o nome
             e contorno da sua cor; aceso em íris quando uma aba está a ser arrastada por cima (MainWindow.Workspaces.cs) -->
        <DataTemplate x:Key="SpaceChipTemplate">
            <Border x:Name="Chip" Height="26" MinWidth="30" Margin="1,0" Padding="8,0" CornerRadius="13" Cursor="Hand"
                    Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent"
                    ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Summary}"
                    PreviewMouseLeftButtonUp="SpaceChip_Click" PreviewMouseRightButtonUp="SpaceChip_RightClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChipGlyph" Text="{Binding ChipText}" FontFamily="{StaticResource EmojiFont}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,1" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChipName" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,1"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Visibility="Collapsed"
                               MaxWidth="120" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding ColorBrush}" />
                    <Setter TargetName="ChipName" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                    <Setter TargetName="ChipName" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- O atual já mostra o nome: a inicial só repetiria a primeira letra (o emoji fica) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True" />
                        <Condition Binding="{Binding Icon}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ChipGlyph" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=Chip}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="PaletteItem_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent" Padding="0,9,14,9" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" CornerRadius="1.5" Background="{DynamicResource IrisBrush}" Visibility="Hidden" Margin="0,3" />
                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PressedBrush}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border x:Name="Chip" Grid.Column="3" CornerRadius="7" Background="{DynamicResource HoverBrush}" Padding="8,3" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                                <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCardTip" TargetType="ToolTip">
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Margin="10,0,10,20" Width="300" CornerRadius="14" Padding="14,12"
                                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Border x:Name="Thumb" CornerRadius="8" Height="160" Margin="0,0,0,10" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PageTitle" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                <TextBlock x:Name="Note" Text="{Binding Note, StringFormat=✎ {0}}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic" />
                                <TextBlock x:Name="Status" Text="{Binding StatusLine}" FontSize="11.5" Foreground="{DynamicResource IrisBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusLine}" Value="">
                                <Setter TargetName="Status" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- O título da página só interessa quando a aba tem nome próprio -->
                            <DataTrigger Binding="{Binding CustomTitle}" Value="{x:Null}">
                                <Setter TargetName="PageTitle" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="TabItem_PreviewMouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel x:Name="Outer" Orientation="Horizontal">
                        <Border x:Name="GroupPill" Visibility="Collapsed" Height="24" Margin="4,6,4,6" Padding="10,0" CornerRadius="12"
                                VerticalAlignment="Center" Background="{Binding Group.ColorBrush}" Cursor="Hand"
                                AutomationProperties.Name="{Binding Group.Name, StringFormat=Grupo «{0}»: clique para encolher ou expandir}"
                                PreviewMouseLeftButtonDown="GroupPill_PreviewMouseLeftButtonDown"
                                PreviewMouseRightButtonUp="GroupPill_PreviewMouseRightButtonUp"
                                MouseEnter="GroupPill_MouseEnter" MouseLeave="GroupPill_MouseLeave">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Group.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#0B0D13"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="GroupCountText" Text="{Binding GroupCount, StringFormat={} · {0}}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#0B0D13" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="TabRoot" Height="36" Background="Transparent" RenderTransformOrigin="0,0.5"
                              Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTipService.InitialShowDelay="450" ToolTipService.Placement="Bottom">
                            <Grid.ToolTip>
                                <ToolTip Style="{StaticResource TabCardTip}" />
                            </Grid.ToolTip>
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="10,10,0,0" Background="Transparent" />
                            <Border x:Name="Glow" Height="2" VerticalAlignment="Top" Margin="14,0" CornerRadius="1"
                                    Background="{DynamicResource IrisBrush}" Visibility="Collapsed" />
                            <Border x:Name="GroupLine" Height="2.5" VerticalAlignment="Bottom" Margin="6,0" CornerRadius="1"
                                    Background="{Binding Group.ColorBrush}" />
                            <Grid x:Name="TabContent" Margin="12,0,8,0" Opacity="{Binding AgeOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16">
                                    <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Grid x:Name="Globe" Visibility="Collapsed">
                                        <Border x:Name="Badge" CornerRadius="5" Background="{Binding MonogramBrush}">
                                            <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                        </Border>
                                        <TextBlock x:Name="GlobeGlyph" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border x:Name="CustomIcon" CornerRadius="5" Background="{Binding IconBrush}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding IconText}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                   FontFamily="{StaticResource EmojiFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                    </Border>
                                    <Ellipse x:Name="NewTabIcon" Width="13" Height="13" Stroke="{DynamicResource IrisBrush}"
                                             StrokeThickness="2.5" Visibility="Collapsed" />
                                    <Path x:Name="Spinner" Style="{StaticResource SpinnerArc}" Visibility="Collapsed" />
                                    <Ellipse x:Name="NoteDot" Width="7" Height="7" Fill="{DynamicResource IrisBrush}" Stroke="{DynamicResource FrameBrush}"
                                             StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                             Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding DisplayTitle}" Margin="8,0,4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="TabAudio" Content="{Binding AudioGlyph}" Style="{StaticResource TabCloseButton}"
                                            FontSize="11" Click="TabAudio_Click" ToolTip="Silenciar / reativar o som desta aba"
                                            Visibility="Collapsed" />
                                    <TextBlock x:Name="TabLock" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,6,0"
                                               Visibility="Collapsed" ToolTip="Trancada: não fecha por engano nem adormece (destranque no menu da aba)" />
                                    <Button x:Name="TabClose" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}"
                                            AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Fechar «{0}»}"
                                            Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                <Setter TargetName="GroupLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupHead}" Value="True">
                                <Setter TargetName="GroupPill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHiddenByGroup}" Value="True">
                                <Setter TargetName="Outer" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGroupHead}" Value="True" />
                                    <Condition Binding="{Binding Group.IsCollapsed}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TabRoot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="GroupCountText" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.85" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Monogram}" Value="{x:Null}">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="GlobeGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNewTab}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                <Setter TargetName="NoteDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CustomIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CustomIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAudible}" Value="True">
                                <Setter TargetName="TabAudio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="TabAudio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="TabRoot" Property="Width" Value="44" />
                                <Setter TargetName="TabContent" Property="Margin" Value="14,0,0,0" />
                                <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Glow" Property="Margin" Value="10,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TabLock" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Multi-seleção (Ctrl/Shift+clique): contorno íris e fundo realçado -->
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5,1.5,1.5,0" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                <Setter TargetName="TabTitle" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Favicon" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Globe" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChromeSurfaceBrush}" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <!-- Modo compacto: a aba vive dentro da barra de ferramentas, por isso a ativa é uma pílula -->
                            <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="TabRoot" Property="Height" Value="32" />
                                <Setter TargetName="Bg" Property="CornerRadius" Value="9" />
                                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="GroupLine" Property="Margin" Value="10,0,10,2" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha da lista «▾» de todas as abas -->
        <Style x:Key="TabListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TabListItem_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="8,6,10,6" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" CornerRadius="1.5" Background="{DynamicResource IrisBrush}" Visibility="Hidden" Margin="0,3,6,3" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra lateral unificada: listas (Para ler, Favoritos, Histórico) com linhas clicáveis e cabeçalhos por dia -->
        <Style x:Key="SidebarList" TargetType="ItemsControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="True">
                            <ItemsPresenter Margin="0,2,0,8" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type sidebar:SidebarHeading}">
            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="20,12,16,4"
                       Foreground="{DynamicResource TextFaintBrush}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sidebar:SidebarLink}">
            <Border x:Name="Bg" Height="46" Margin="8,1" CornerRadius="9" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Url}" ToolTipService.InitialShowDelay="700" AutomationProperties.Name="{Binding Title}"
                    PreviewMouseDown="SidebarLink_PreviewMouseDown" PreviewMouseRightButtonUp="SidebarLink_PreviewMouseRightButtonUp">
                <Grid x:Name="Content" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Mono" Width="22" Height="22" CornerRadius="7" Background="{Binding Color}" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Border>
                    <Image x:Name="Icon" Width="18" Height="18" Margin="2,0,0,0" Source="{Binding Icon}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subline}" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
                    <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Content" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Mono" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Separadores da barra lateral: um botão por painel; Tag «on» marca o que está à vista -->
        <Style x:Key="SidebarRailButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="10" />
                            <Border x:Name="Mark" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                    Background="{DynamicResource IrisBrush}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource IrisBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="TabItem_PreviewMouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Row" Height="38" Margin="6,1" Background="Transparent" Cursor="Hand" RenderTransformOrigin="0,0.5" ToolTipService.InitialShowDelay="450" ToolTipService.Placement="Bottom">
                            <Grid.ToolTip>
                                <ToolTip Style="{StaticResource TabCardTip}" />
                            </Grid.ToolTip>
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="1.5"
                                    Background="{DynamicResource IrisBrush}" Visibility="Hidden" />
                            <Border x:Name="SideGroup" Width="4" HorizontalAlignment="Right" Margin="0,8,2,8" CornerRadius="2"
                                    Background="{Binding Group.ColorBrush}" />
                            <Grid Margin="13,0,6,0" Opacity="{Binding AgeOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16">
                                    <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="Badge" CornerRadius="5" Background="{Binding MonogramBrush}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                    </Border>
                                    <TextBlock x:Name="SideGlobe" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border x:Name="CustomIcon" CornerRadius="5" Background="{Binding IconBrush}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding IconText}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                   FontFamily="{StaticResource EmojiFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                    </Border>
                                    <Ellipse x:Name="NewTabIcon" Width="13" Height="13" Stroke="{DynamicResource IrisBrush}"
                                             StrokeThickness="2.5" Visibility="Collapsed" />
                                    <Path x:Name="Spinner" Style="{StaticResource SpinnerArc}" Visibility="Collapsed" />
                                    <Ellipse x:Name="NoteDot" Width="7" Height="7" Fill="{DynamicResource IrisBrush}" Stroke="{DynamicResource FrameBrush}"
                                             StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                             Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding DisplayTitle}" Margin="10,0,4,0" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="Audio" Content="{Binding AudioGlyph}" Style="{StaticResource TabCloseButton}"
                                            FontSize="11" Click="TabAudio_Click" Visibility="Collapsed" />
                                    <TextBlock x:Name="SideLock" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0"
                                               Visibility="Collapsed" ToolTip="Trancada: não fecha por engano nem adormece (destranque no menu da aba)" />
                                    <Button x:Name="Close" Content="&#xE8BB;" Style="{StaticResource TabCloseButton}"
                                            AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Fechar «{0}»}"
                                            Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)" Visibility="Hidden" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                <Setter TargetName="SideGroup" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHiddenByGroup}" Value="True">
                                <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.85" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Favicon}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Monogram}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideGlobe" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsNewTab}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideGlobe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                <Setter TargetName="NoteDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideGlobe" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CustomIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter TargetName="Favicon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NewTabIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CustomIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAudible}" Value="True">
                                <Setter TargetName="Audio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter TargetName="Audio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                <Setter TargetName="Title" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Favicon" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Badge" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SideLock" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SideCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Suggestion_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="0,7,12,7" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" CornerRadius="1.5" Background="{DynamicResource IrisBrush}" Visibility="Hidden" Margin="0,2" />
                                <TextBlock x:Name="Icon" Grid.Column="1" Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <Border x:Name="Mono" Grid.Column="1" Width="22" Height="22" CornerRadius="7"
                                        Background="{Binding MonogramColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Monogram}" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Text}" FontSize="14" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail, StringFormat={} — {0}}" FontSize="13"
                                           Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Monogram}" Value="{x:Null}">
                                <Setter TargetName="Mono" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Search">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE721;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Navigate">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE71B;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Bookmark">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource IrisBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Tab">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8AB;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Answer">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8EF;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource IrisBrush}" />
                                <Setter TargetName="Label" Property="FontSize" Value="17" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OmniboxFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource IrisBrush}" />
                    <Setter Property="Background" Value="{DynamicResource FieldFocusBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReloadButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE72C;" />
            <Setter Property="ToolTip" Value="Recarregar (F5)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active.IsLoading}" Value="True">
                    <Setter Property="Content" Value="&#xE711;" />
                    <Setter Property="ToolTip" Value="Parar (Esc)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="AuroraBrush" StartPoint="0,0" EndPoint="0.5,0" SpreadMethod="Repeat">
            <LinearGradientBrush.RelativeTransform>
                <TranslateTransform />
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#008B5CF6" Offset="0" />
            <GradientStop Color="#8B5CF6" Offset="0.2" />
            <GradientStop Color="#22D3EE" Offset="0.45" />
            <GradientStop Color="#34D399" Offset="0.7" />
            <GradientStop Color="#F472B6" Offset="0.9" />
            <GradientStop Color="#008B5CF6" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="42" />
                <RowDefinition x:Name="ToolbarRow" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título com abas -->
            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="TabStripHost" SizeChanged="TabStripHost_SizeChanged">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Grid x:Name="BrandMark" Width="40" Height="36" ToolTip="Éteris">
                            <Ellipse Width="18" Height="18" Stroke="{DynamicResource IrisBrush}" StrokeThickness="3" />
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource TextBrush}" />
                        </Grid>
                        <!-- Selo «Privada»: clique liga/desliga «Esconder das capturas e do Recall» (MainWindow.Private.cs) -->
                        <Border x:Name="PrivateBadge" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,3"
                                CornerRadius="10" Padding="10,3" Background="#3B1D6E" BorderBrush="#7C3AED" BorderThickness="1"
                                Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseLeftButtonUp="PrivateBadge_Click" AutomationProperties.Name="Janela privada">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PrivateCaptureGlyph" Text="&#xED1A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="#E9D5FF" VerticalAlignment="Center" Margin="0,1,6,0" Visibility="Collapsed" />
                                <TextBlock Text="Privada" FontSize="11.5" FontWeight="SemiBold" Foreground="#E9D5FF" />
                            </StackPanel>
                        </Border>
                        <!-- Espaços: um chip por Espaço (cor e emoji ou inicial; o atual com o nome), só quando há mais do que um.
                             Clique muda de Espaço, botão direito abre o menu, largar uma aba move-a (MainWindow.Workspaces.cs) -->
                        <ItemsControl x:Name="SpaceStrip" ItemsSource="{Binding Workspaces}" VerticalAlignment="Center" Margin="0,0,6,3"
                                      Visibility="Collapsed" Focusable="False" SizeChanged="SpaceStrip_SizeChanged"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Espaços"
                                      ItemTemplate="{StaticResource SpaceChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- Setas de rolagem: só aparecem quando há abas escondidas (ver MainWindow.TabStrip.cs) -->
                        <Button x:Name="TabScrollLeft" Content="&#xE76B;" Style="{StaticResource IconButton}" Width="24" Height="30" FontSize="10"
                                Margin="0,0,0,3" Visibility="Collapsed" Click="TabScrollLeft_Click" ToolTip="Abas anteriores" />
                        <Grid>
                            <!-- A faixa rola sem barra visível; as abas mantêm a largura mínima legível (TabLayout.MinTabWidth) -->
                            <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" PanningMode="HorizontalOnly" CanContentScroll="False"
                                          PreviewMouseWheel="TabScroll_PreviewMouseWheel" ScrollChanged="TabScroll_ScrollChanged"
                                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Active}"
                                         PreviewMouseMove="TabList_PreviewMouseMove" PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp" LostMouseCapture="TabList_LostMouseCapture"
                                         ItemContainerStyle="{StaticResource TabItemStyle}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </ScrollViewer>
                            <!-- Sombras nas pontas: há mais abas para esse lado -->
                            <Border x:Name="TabFadeLeft" Width="18" HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource FrameColor}" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TabFadeRight" Width="18" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="{DynamicResource FrameColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <Button x:Name="TabScrollRight" Content="&#xE76C;" Style="{StaticResource IconButton}" Width="24" Height="30" FontSize="10"
                                Margin="0,0,0,3" Visibility="Collapsed" Click="TabScrollRight_Click" ToolTip="Abas seguintes" />
                        <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                Margin="6,0,0,3" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" />
                        <Button x:Name="TabListButton" Content="&#xE70D;" Style="{StaticResource IconButton}" Width="26" Height="30" FontSize="9"
                                Margin="2,0,0,3" Click="TabListButton_Click" ToolTip="Todas as abas" />
                    </StackPanel>

                    <!-- Lista «▾» de todas as abas: pesquisável, pela ordem da faixa, com a ativa marcada (MainWindow.TabStrip.cs) -->
                    <Popup x:Name="TabListPopup" PlacementTarget="{Binding ElementName=TabListButton}" Placement="Bottom"
                           HorizontalOffset="-180" VerticalOffset="2" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade" Opened="TabListPopup_Opened">
                        <Border Margin="32,0,32,44" Width="360" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,2,2,6">
                                    <Border Height="34" CornerRadius="10" Background="{DynamicResource FieldBrush}"
                                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" />
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                                    <TextBlock x:Name="TabListSearchHint" Text="Procurar nas abas abertas" FontSize="13" Margin="34,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                                    <TextBox x:Name="TabListSearch" Style="{StaticResource BareTextBox}" FontSize="13" Margin="32,0,10,0"
                                             VerticalAlignment="Center" AutomationProperties.Name="Procurar nas abas abertas"
                                             TextChanged="TabListSearch_TextChanged" PreviewKeyDown="TabListSearch_PreviewKeyDown" />
                                </Grid>
                                <ListBox x:Name="TabListMenuList" Grid.Row="1" MaxHeight="420" Background="Transparent" BorderThickness="0"
                                         Padding="0" ItemContainerStyle="{StaticResource TabListItemStyle}"
                                         AutomationProperties.Name="Abas abertas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="8" Background="{Binding BadgeBrush}" Margin="0,0,10,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Width="16" Height="16" Source="{Binding Image}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Status, StringFormat={} · {0}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TabListStatus" Grid.Row="2" FontSize="11" Margin="10,8,10,4" Foreground="{DynamicResource TextFaintBrush}" />
                                <Button x:Name="TabListVertical" Grid.Row="3" Style="{StaticResource PillButton}" Margin="6,4,6,2"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Click="TabListVertical_Click"
                                        Content="Muitas abas? Passar para abas verticais" ToolTip="A lista lateral mostra os títulos completos e aguenta dezenas de abas" />
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar" />
                </StackPanel>
            </Grid>

            <!-- Barra de ferramentas -->
            <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource ChromeSurfaceBrush}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Modo compacto: a faixa de abas (TabStripHost) vem para esta coluna e o endereço fica com largura fixa -->
                        <ColumnDefinition x:Name="ToolbarTabsColumn" Width="0" />
                        <ColumnDefinition x:Name="ToolbarOmniboxColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="CompactTabHost" Grid.Column="1" Margin="4,0,0,0" />
                    <!-- Com abas verticais ou em modo compacto a barra de título desaparece: os botões da janela vêm para aqui -->
                    <StackPanel x:Name="ToolbarCaption" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top"
                                Height="34" Margin="8,0,-8,0" Visibility="Collapsed">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" />
                        <Button x:Name="MaximizeButton2" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Click="Back_Click"
                                IsEnabled="{Binding Active.CanGoBack}" ToolTip="Voltar (Alt+←)" />
                        <Button Content="&#xE72A;" Style="{StaticResource IconButton}" Click="Forward_Click"
                                IsEnabled="{Binding Active.CanGoForward}" ToolTip="Avançar (Alt+→)" />
                        <Button Style="{StaticResource ReloadButton}" Click="Reload_Click" />
                    </StackPanel>

                    <Border x:Name="OmniboxFrame" Grid.Column="2" Style="{StaticResource OmniboxFrame}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Height="36" CornerRadius="18" BorderThickness="1.5" Margin="8,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SiteInfoButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Margin="6,0,2,0" Click="SiteInfo_Click">
                                <TextBlock x:Name="SiteIcon" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Button>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReaderButton" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,2,0"
                                        Click="Reader_Click" ToolTip="Modo de leitura (F9)"
                                        Visibility="{Binding Active.IsReaderable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE736;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <Button x:Name="VideoOfferButton" Visibility="Collapsed" Click="VideoOfferButton_Click" Cursor="Hand"
                                        Margin="0,0,4,0" AutomationProperties.Name="Tocar no motor de vídeo"
                                        ToolTip="O vídeo desta página não toca no motor principal (formato H.264/AAC ou conteúdo protegido). Clique para a abrir no motor de vídeo do Windows (WebView2); o site fica lembrado.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}"
                                                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Tocar no motor de vídeo" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                </Button>
                                <Button x:Name="VideoEngineBadge" Visibility="Collapsed" Click="VideoEngineBadge_Click" Cursor="Hand"
                                        Margin="0,0,4,0" AutomationProperties.Name="Motor de vídeo: voltar ao motor principal"
                                        ToolTip="Esta aba usa o motor de vídeo do Windows (WebView2) porque o site só tem vídeo em H.264. Clique para voltar ao motor principal.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}"
                                                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Motor de vídeo" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                </Button>
                                <Button x:Name="SplitBadge" Visibility="Collapsed" Click="SplitBadge_Click" Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="Ecrã dividido: trocar lados, empilhar ou desfazer">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}"
                                                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SplitBadgeGlyph" Text="&#xE9A6;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="5,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="SplitBadgeText" Text="Dividido" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                </Button>
                                <Button x:Name="ZoomBadge" Visibility="Collapsed" Click="ZoomBadge_Click" Cursor="Hand"
                                        ToolTip="Repor o zoom deste site (Ctrl+0)" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="{DynamicResource SelectedBrush}"
                                                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PressedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="ZoomBadgeText" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                </Button>
                                                            <Button x:Name="StarButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Margin="0,0,4,0" Click="Star_Click" ToolTip="Adicionar aos favoritos (Ctrl+D)" Visibility="Collapsed">
                                <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                            </Button>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                <TextBox x:Name="Omnibox" Style="{StaticResource BareTextBox}"
                                         PreviewKeyDown="Omnibox_PreviewKeyDown" GotKeyboardFocus="Omnibox_GotKeyboardFocus"
                                         TextChanged="Omnibox_TextChanged"
                                         PreviewMouseLeftButtonDown="Omnibox_PreviewMouseLeftButtonDown"
                                         LostKeyboardFocus="Omnibox_LostKeyboardFocus" />
                                <TextBlock x:Name="OmniboxDisplay" IsHitTestVisible="False" VerticalAlignment="Center"
                                           FontSize="14" Margin="2,0,0,1" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="DisplayHost" Foreground="{DynamicResource TextBrush}" /><Run x:Name="DisplayRest" Foreground="{DynamicResource TextFaintBrush}" />
                                </TextBlock>
                                <TextBlock x:Name="OmniboxPlaceholder" IsHitTestVisible="False" VerticalAlignment="Center"
                                           FontSize="14" Margin="2,0,0,1" Foreground="{DynamicResource TextFaintBrush}"
                                           Text="Pesquisar ou escrever um endereço" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Informação do site (cadeado) -->
                    <Popup x:Name="SiteInfoPopup" PlacementTarget="{Binding ElementName=SiteInfoButton}" Placement="Bottom"
                           HorizontalOffset="-20" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade" Closed="SiteInfoPopup_Closed">
                        <Border Margin="32,0,32,44" Width="360" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <!-- O cartão cresce com o que o site sabe, as permissões e a confirmação de «Triturar»: nunca passa do
                                 fundo do ecrã (MaxHeight posto ao abrir, em SiteInfo_Click) e rola por dentro. -->
                            <ScrollViewer x:Name="SiteInfoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" PanningMode="VerticalOnly" Margin="0,0,-14,0">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="MinWidth" Value="6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border CornerRadius="3" Background="{DynamicResource FieldBorderBrush}" />
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                            <StackPanel Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Ellipse x:Name="SiteInfoHalo" Fill="#3DDC97" />
                                        <TextBlock x:Name="SiteInfoGlyph" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   Foreground="#0B0D13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SiteInfoTitle" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SiteInfoHost" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SiteInfoDetail" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18" />
                                <!-- Site aceite por http:// («Continuar» ou «Sempre»): desfazer a escolha -->
                                <Button x:Name="SiteInfoRetryHttps" Content="Voltar a tentar HTTPS neste site" Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="SiteInfoRetryHttps_Click" />

                                <StackPanel x:Name="SiteInfoSiteSection">
                                    <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,16,0,12" />
                                    <TextBlock Text="PERMISSÕES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="SiteInfoNoPermissions" Text="Este site não tem permissões guardadas."
                                               FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ItemsControl x:Name="SiteInfoPermissions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" CornerRadius="8" Background="{Binding StateBrush}" Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="#0B0D13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="&#xE894;" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                            FontSize="11" Margin="6,0,0,0" ToolTip="Esquecer (voltar a perguntar)"
                                                            Tag="{Binding Kind}" Click="SiteInfoForget_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,14,0,12" />
                                    <TextBlock x:Name="SiteInfoTrackers" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />

                                    <!-- O que este site sabe de ti: cookies, armazenamento, terceiros, referrer e rede local -->
                                    <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,14,0,12" />
                                    <TextBlock Text="O QUE ESTE SITE SABE DE TI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}"
                                               Margin="0,0,0,6" />
                                    <ItemsControl x:Name="SiteKnowledgeList" AutomationProperties.Name="O que este site sabe de ti">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource IrisBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Ver no Observatório  ›" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Click="SiteInfoObservatory_Click" />
                                    <Button x:Name="SiteInfoClear" Content="Apagar cookies e dados deste site" Style="{StaticResource PillButton}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="SiteInfoClear_Click" />

                                    <!-- Esquecer ao fechar e Triturar: o site inteiro (domínio registável), nunca outro -->
                                    <Grid x:Name="SiteInfoForgetRow" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Esquecer este site ao fechar" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SiteInfoForgetHint" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,8,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="SiteInfoForgetToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center" Click="SiteInfoForgetToggle_Click" />
                                    </Grid>
                                    <Button x:Name="SiteInfoShred" Content="Triturar agora…" Style="{StaticResource PillButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="SiteInfoShred_Click"
                                            ToolTip="Fecha as abas do site e apaga já os seus dados (com confirmação)" />
                                    <Border x:Name="SiteInfoShredConfirm" Visibility="Collapsed" CornerRadius="12" Padding="12" Margin="0,10,0,0"
                                            Background="{DynamicResource PressedBrush}" BorderBrush="#66FF7A90" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="SiteInfoShredText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="SiteInfoShredGo" Content="Triturar" Style="{StaticResource PrimaryPillButton}"
                                                        Click="SiteInfoShredConfirm_Click" />
                                                <Button Content="Cancelar" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                                        Click="SiteInfoShredCancel_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=OmniboxFrame}" Placement="Bottom"
                           HorizontalOffset="0" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True"
                           PopupAnimation="Fade" Focusable="False">
                        <Border Margin="32,0,32,44" Width="{Binding ActualWidth, ElementName=OmniboxFrame}" MinWidth="600"
                                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <ListBox x:Name="SuggestionList" Focusable="False" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </Border>
                    </Popup>

                    <StackPanel x:Name="ToolbarRight" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="UpdatePill" Visibility="Collapsed" Click="UpdatePill_Click" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Fecha e reabre o Éteris com a nova versão (as abas são mantidas)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pill" CornerRadius="15" Height="30" Padding="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#C4B5FD" Offset="0" />
                                                <GradientStop Color="#67E8F9" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#0B0D13"
                                                       VerticalAlignment="Center" Margin="0,1,8,0" />
                                            <TextBlock x:Name="UpdatePillText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#0B0D13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Grid x:Name="MediaHost" Visibility="Collapsed" Margin="0,0,4,0">
                            <Button x:Name="MediaButton" Style="{StaticResource IconButton}" Click="MediaButton_Click"
                                    AutomationProperties.AutomationId="MediaButton" AutomationProperties.Name="Multimédia"
                                    ToolTip="Multimédia: o que está a tocar nas abas">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                            </Button>
                            <Ellipse x:Name="MediaLiveDot" Width="7" Height="7" Fill="{DynamicResource IrisBrush}" IsHitTestVisible="False"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <Grid x:Name="DownloadsHost" Visibility="Collapsed" Margin="0,0,4,0">
                            <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" Click="Downloads_Click"
                                    ToolTip="Transferências (Ctrl+J)">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                            </Button>
                            <Ellipse Width="30" Height="30" Stroke="{DynamicResource FieldBorderBrush}" StrokeThickness="2" IsHitTestVisible="False"
                                     x:Name="DownloadsTrack" Visibility="Collapsed" />
                            <Path x:Name="DownloadsRing" Stroke="{DynamicResource IrisBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                  Width="34" Height="34" />
                        </Grid>
                        <Grid>
                            <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" Click="Shield_Click"
                                    ToolTip="Escudo do Éteris">
                                <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                            </Button>
                            <Border x:Name="ShieldBadge" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,0,-3,0" MinWidth="17" Height="16" CornerRadius="8" Padding="4,0"
                                    Background="{DynamicResource IrisBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ShieldCount" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Border>
                        </Grid>
                        <Button Content="&#xE71D;" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Radar_Click"
                                AutomationProperties.Name="Radar de abas" ToolTip="Radar de abas (Ctrl+Shift+A)" />
                        <Button x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Menu_Click"
                                PreviewMouseLeftButtonDown="MenuButton_PreviewMouseLeftButtonDown"
                                Focusable="True" ToolTip="Menu do Éteris (Alt+F)" />
                    </StackPanel>

                    <Popup x:Name="MediaPopup" PlacementTarget="{Binding ElementName=MediaButton}" Placement="Bottom"
                           HorizontalOffset="-322" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="32,0,32,44" Width="370" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="10,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="10,0,6,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                            Content="&#xE769;" Click="PauseAllMedia_Click" ToolTip="Pausar tudo" />
                                    <TextBlock Text="Multimédia" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="MediaList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="12" Padding="10,8" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="MediaRow_Click" ToolTip="Ir para esta aba">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="10" Background="{Binding MonogramBrush}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="15" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Favicon}" Width="18" Height="18" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MediaHeadline}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding MediaSubline}" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                                                            Content="{Binding PlayPauseGlyph}" Click="MediaPlayPause_Click" ToolTip="Tocar / pausar" />
                                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                                                            Content="{Binding MuteGlyph}" Click="MediaMute_Click" ToolTip="Silenciar / repor o som" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom"
                           HorizontalOffset="-322" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="32,0,32,44" Width="370" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="10,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="10,0,6,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                            Content="&#xE838;" Click="OpenDownloadsFolder_Click" ToolTip="Abrir a pasta Transferências" />
                                    <TextBlock Text="Transferências" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Nenhuma transferência nesta sessão" Margin="10,4,10,9"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=DownloadsList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl x:Name="DownloadsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="12" Padding="10,8" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="DownloadRow_Click" ToolTip="{Binding FullPath}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PressedBrush}">
                                                        <TextBlock x:Name="Glyph" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" />
                                                        <ProgressBar x:Name="Bar" Height="3" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay}">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid>
                                                                        <Border x:Name="PART_Track" CornerRadius="1.5" Background="{DynamicResource FieldBorderBrush}" />
                                                                        <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left"
                                                                                Background="{DynamicResource IrisBrush}" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                    <Button x:Name="Cancel" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            FontSize="10" Content="&#xE711;" Click="CancelDownload_Click" ToolTip="Cancelar" />
                                                    <Button x:Name="Folder" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            FontSize="12" Content="&#xE838;" Click="ShowDownloadInFolder_Click"
                                                            ToolTip="Mostrar na pasta" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Cancel" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Folder" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                                    <Setter TargetName="Folder" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="ShieldPopup" PlacementTarget="{Binding ElementName=ShieldButton}" Placement="Bottom"
                           HorizontalOffset="-322" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Margin="32,0,32,44" Width="350" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Ellipse x:Name="ShieldHalo" Fill="{DynamicResource IrisBrush}" Opacity="0.9" />
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentInkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ShieldTitle" Text="Escudo ativo" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ShieldSite" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShieldToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center" Click="ShieldToggle_Click" ToolTip="Proteção neste site" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ShieldBigCount" FontSize="40" FontWeight="Light" Foreground="{DynamicResource IrisBrush}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="ShieldCountLabel" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="10,0,0,9" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="220" />
                                </StackPanel>

                                <ItemsControl x:Name="ShieldHosts" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource PressedBrush}" Padding="7,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,14,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Modo rigoroso" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Bloqueia scripts e frames de outros domínios neste site" FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,8,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="StrictToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Click="StrictToggle_Click" ToolTip="Pode partir partes de alguns sites (vídeos e comentários incorporados)" />
                                </Grid>

                                <TextBlock x:Name="ShieldObservatoryLine" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,6"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ShieldObservatoryButton" Content="Abrir o Observatório  ›" Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,12" Click="ShieldObservatory_Click"
                                        ToolTip="Quem está a observar esta página, ao vivo, agrupado por empresa" />
                                <TextBlock x:Name="ShieldCheckHeaders" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckCookies" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckWebRtc" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckDns" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                <TextBlock x:Name="ShieldCheckLan" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" TextWrapping="Wrap" />
                                <TextBlock x:Name="ShieldCheckBounce" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" TextWrapping="Wrap" />
                                <TextBlock x:Name="ShieldCheckCname" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" TextWrapping="Wrap" />
                                <TextBlock x:Name="ShieldCheckBounceSites" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ShieldSession" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Página: flutua sobre a superfície, com cantos arredondados -->
            <!-- Abas verticais -->
            <Border x:Name="SideBar" Grid.Row="2" Width="248" HorizontalAlignment="Left" Visibility="Collapsed"
                    Background="{DynamicResource ChromeSurfaceBrush}" Padding="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" Cursor="Hand" Margin="6,2,6,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Height="38" CornerRadius="10" Background="Transparent" Padding="13,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" Width="16"
                                                   Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="L" Text="Nova aba" FontSize="13" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                        <Setter TargetName="L" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SideCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="L" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Espaços nas abas verticais: os mesmos chips, em linhas, por cima do filtro -->
                    <ItemsControl x:Name="SideSpaceStrip" DockPanel.Dock="Top" ItemsSource="{Binding Workspaces}" Margin="8,0,8,6"
                                  Visibility="Collapsed" Focusable="False" AutomationProperties.Name="Espaços"
                                  ItemTemplate="{StaticResource SpaceChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Grid x:Name="SideFilterHost" DockPanel.Dock="Top" Margin="10,0,10,6">
                        <Border Height="32" CornerRadius="9" Background="{DynamicResource FieldBrush}"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="11,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                        <TextBlock x:Name="SideFilterHint" Text="Filtrar abas" FontSize="12.5" Margin="31,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                        <TextBox x:Name="SideFilter" Style="{StaticResource BareTextBox}" FontSize="12.5" Margin="29,0,8,0"
                                 VerticalAlignment="Center" AutomationProperties.AutomationId="SideFilter"
                                 AutomationProperties.Name="Filtrar abas" TextChanged="SideFilter_TextChanged"
                                 PreviewKeyDown="SideFilter_PreviewKeyDown" />
                    </Grid>
                    <Button x:Name="SideCollapseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="10,4,0,0"
                            Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12"
                            Content="&#xE76B;" Click="SideCollapse_Click" ToolTip="Encolher a barra de abas" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="SideTabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Active}"
                                 ItemContainerStyle="{StaticResource SideTabItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="PageFrame" Grid.Row="2" Background="{DynamicResource ChromeSurfaceBrush}" Padding="6,0,6,6">
                <Grid x:Name="BrowserHost" Background="#FFFFFF" SizeChanged="BrowserHost_SizeChanged" PreviewMouseWheel="BrowserHost_PreviewMouseWheel">
                    <Rectangle x:Name="AuroraBar" Height="3" VerticalAlignment="Top" Panel.ZIndex="10"
                               Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Barra lateral unificada (Ctrl+Shift+B): Notas, Para ler, Favoritos, Histórico e sites fixados, ao lado da página.
                 Não fica por cima da página (a moldura encolhe): pode viver na janela principal. -->
            <Border x:Name="Sidebar" Grid.Row="2" Width="360" HorizontalAlignment="Right" Visibility="Collapsed"
                    Background="{DynamicResource ChromeSurfaceBrush}" AutomationProperties.Name="Barra lateral">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarStartColumn" Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SidebarEndColumn" Width="44" />
                    </Grid.ColumnDefinitions>
                    <Thumb x:Name="SidebarGrip" Grid.Column="0" Cursor="SizeWE" ToolTip="Arraste para ajustar a largura da barra lateral"
                           DragDelta="SidebarGrip_DragDelta" DragCompleted="SidebarGrip_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Border x:Name="SidebarCard" Grid.Column="1" Margin="0,0,0,6" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="14,8,8,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                        Content="&#xE8BB;" Click="SidebarClose_Click" ToolTip="Fechar a barra lateral (Ctrl+Shift+B)" />
                                <Button x:Name="WebPanelOpenButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                        Content="&#xE8A7;" Click="WebPanelOpen_Click" ToolTip="Abrir este site numa aba" Visibility="Collapsed" />
                                <Button x:Name="WebPanelReloadButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                        Content="&#xE72C;" Click="WebPanelReload_Click" ToolTip="Recarregar" Visibility="Collapsed" />
                                <Button x:Name="NotesInsertButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                        Content="&#xE71B;" Click="NotesInsertPage_Click" ToolTip="Inserir o título e o endereço desta página" />
                                <TextBlock x:Name="SidebarTitle" Text="Notas" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Grid x:Name="SidebarBody">
                                <DockPanel x:Name="SidebarNotes" Margin="14,2,10,10" Visibility="Collapsed">
                                    <TextBlock x:Name="NotesStatus" DockPanel.Dock="Bottom" FontSize="11" Margin="2,6,0,0"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBox x:Name="NotesText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="2,4"
                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" FontSize="13.5"
                                             AutomationProperties.AutomationId="NotesText" AutomationProperties.Name="Notas"
                                             TextChanged="NotesText_TextChanged" PreviewKeyDown="NotesText_PreviewKeyDown" />
                                </DockPanel>
                                <!-- Para ler, Favoritos e Histórico: um filtro em cima (as mesmas regras do filtro das abas) e a lista;
                                     com o foco no filtro, ↑/↓ escolhem a linha, Enter abre, Ctrl+Enter abre numa aba nova,
                                     Shift+Delete tira-a e Shift+F10/tecla de menu dá o menu da linha (MainWindow.Sidebar.cs) -->
                                <DockPanel x:Name="SidebarLinks" Visibility="Collapsed">
                                    <Grid DockPanel.Dock="Top" Margin="14,2,12,6">
                                        <Border Height="32" CornerRadius="9" Background="{DynamicResource FieldBrush}"
                                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                                        <TextBlock x:Name="SidebarFilterHint" Text="Filtrar" FontSize="12.5" Margin="31,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False" />
                                        <TextBox x:Name="SidebarFilter" Style="{StaticResource BareTextBox}" FontSize="12.5" Margin="29,0,8,0"
                                                 VerticalAlignment="Center" AutomationProperties.AutomationId="SidebarFilter"
                                                 AutomationProperties.Name="Filtrar" TextChanged="SidebarFilter_TextChanged"
                                                 PreviewKeyDown="SidebarFilter_PreviewKeyDown" />
                                    </Grid>
                                    <TextBlock x:Name="SidebarLinksEmpty" DockPanel.Dock="Top" Margin="18,16,18,0" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                               Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                                    <ItemsControl x:Name="SidebarLinkList" Style="{StaticResource SidebarList}" AutomationProperties.Name="Lista" />
                                </DockPanel>
                                <!-- Sites fixados: um motor por site, em janela própria (MainWindow.WebPanels.cs) -->
                                <Grid x:Name="SidebarWebHost" Margin="1,2,1,1" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="SidebarRail" Grid.Column="2" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- Código QR da página: cartão ao centro, por cima da página escurecida -->
            <Grid x:Name="QrOverlay" Grid.Row="2" Panel.ZIndex="58" Visibility="Collapsed" Focusable="True"
                  Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="QrOverlay_MouseLeftButtonDown" KeyDown="QrOverlay_KeyDown">
                <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18,22,20" CornerRadius="22"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                    Content="&#xE8BB;" Click="QrClose_Click" ToolTip="Fechar (Esc)" />
                            <StackPanel>
                                <TextBlock Text="Abrir no telemóvel" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="QrTitle" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <Border Background="White" CornerRadius="16" Padding="14" HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="Código QR do endereço desta página" />
                        </Border>
                        <TextBlock x:Name="QrCaption" FontSize="12" Margin="0,10,0,4" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Aponte a câmara do telemóvel. O código é feito neste computador."
                                   FontSize="11.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <Button Content="Copiar imagem" Click="QrCopy_Click" Margin="0,0,5,0" Style="{StaticResource PillButton}" />
                            <Button Content="Guardar" Click="QrSave_Click" Margin="5,0,0,0" Style="{StaticResource PillButton}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Espreitar: o destino de um link num cartão por cima da página, sem abrir aba nem deixar rasto -->
            <Grid x:Name="GlanceOverlay" Grid.Row="2" Panel.ZIndex="59" Visibility="Collapsed" Focusable="True"
                  Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="GlanceOverlay_MouseLeftButtonDown" KeyDown="GlanceOverlay_KeyDown"
                  SizeChanged="GlanceOverlay_SizeChanged" AutomationProperties.Name="Espreitar o link">
                <Border x:Name="GlanceCard" Width="540" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="22,12,22,18" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <Button x:Name="GlanceReadLater" DockPanel.Dock="Left" Style="{StaticResource PillButton}" Content="Ler mais tarde"
                                        Click="GlanceReadLater_Click" ToolTip="Guardar em Favoritos › Para ler (Ctrl+Enter)" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PillButton}" Content="Abrir ao lado" Click="GlanceSplit_Click" Margin="0,0,8,0"
                                            ToolTip="Abrir numa aba ao lado desta — ecrã dividido (Shift+Enter)" />
                                    <Button x:Name="GlanceOpenButton" Style="{StaticResource PrimaryPillButton}" Content="Abrir" Click="GlanceOpen_Click"
                                            ToolTip="Abrir numa nova aba (Enter)" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer x:Name="GlanceScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <Border x:Name="GlanceImageHost" Height="210" CornerRadius="21,21,0,0" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="GlanceImage" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <StackPanel Margin="22,16,22,16">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                                Content="&#xE8BB;" Click="GlanceClose_Click" ToolTip="Fechar (Esc)" Margin="8,-4,-6,0" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource IrisBrush}"
                                                       VerticalAlignment="Center" Margin="0,1,6,0" />
                                            <TextBlock x:Name="GlanceSite" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                            <TextBlock x:Name="GlanceReading" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="GlanceTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="25"
                                               LineStackingStrategy="BlockLineHeight" MaxHeight="75" TextTrimming="WordEllipsis"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="GlanceByline" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    <StackPanel x:Name="GlanceStatus" Orientation="Horizontal" Margin="0,4,0,8">
                                        <Path x:Name="GlanceSpinner" Style="{StaticResource SpinnerArc}" Width="16" Height="16" Margin="0,0,10,0" />
                                        <TextBlock x:Name="GlanceStatusText" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="GlanceDescription" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" Visibility="Collapsed" />
                                    <StackPanel x:Name="GlanceParagraphs" />
                                    <TextBlock x:Name="GlanceUrl" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Janela flutuante: barra para arrastar e voltar ao tamanho normal (aparece com o rato) -->
            <Border x:Name="MiniBar" Grid.Row="2" Panel.ZIndex="60" VerticalAlignment="Top" Height="34" Visibility="Collapsed"
                    Background="#CC0B0D13" MouseLeftButtonDown="MiniBar_MouseLeftButtonDown" Cursor="SizeAll"
                    ToolTip="Arraste para mover · duplo clique para voltar ao tamanho normal">
                <DockPanel Margin="10,0,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE73F;" Click="MiniRestore_Click" Cursor="Hand" Foreground="White"
                            AutomationProperties.AutomationId="MiniRestore" ToolTip="Voltar ao tamanho normal" />
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#C4B5FD"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="MiniTitle" Foreground="White" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Pedido de permissão de um site -->
            <Border x:Name="PermissionBar" Grid.Row="2" Panel.ZIndex="45" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="20,10,0,0" CornerRadius="18" Padding="18,14" MaxWidth="460"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                    BorderThickness="1" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="38" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource IrisBrush}" />
                            <TextBlock x:Name="PermissionGlyph" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="PermissionText" TextWrapping="Wrap" MaxWidth="360" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                    <!-- Rede local: para onde a página tentou ir e quando faz sentido permitir -->
                    <TextBlock x:Name="PermissionDetail" TextWrapping="Wrap" MaxWidth="410" Margin="50,8,0,0" FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <CheckBox x:Name="PermissionRemember" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="PermissionRememberLabel" Text="Lembrar neste site" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button x:Name="PermissionAllowButton" DockPanel.Dock="Right" Content="Permitir"
                                Style="{StaticResource PrimaryPillButton}" Click="PermissionAllow_Click" Margin="8,0,0,0" />
                        <Button x:Name="PermissionOnceButton" DockPanel.Dock="Right" Content="Só desta vez" Visibility="Collapsed"
                                Style="{StaticResource PillButton}" Click="PermissionOnce_Click" Margin="8,0,0,0" />
                        <Button x:Name="PermissionDenyButton" DockPanel.Dock="Right" Content="Bloquear"
                                Style="{StaticResource PillButton}" Click="PermissionDeny_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Procurar na página -->
            <Border x:Name="FindBar" Grid.Row="2" Panel.ZIndex="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,24,0" CornerRadius="20" Padding="14,4,6,4" Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1.5" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
                    <Grid Width="220">
                        <TextBox x:Name="FindInput" Style="{StaticResource BareTextBox}" FontSize="13.5"
                                 TextChanged="FindInput_TextChanged" PreviewKeyDown="FindInput_PreviewKeyDown" />
                        <TextBlock x:Name="FindPlaceholder" Text="Procurar na página" IsHitTestVisible="False" FontSize="13.5"
                                   Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                    </Grid>
                    <TextBlock x:Name="FindCount" FontSize="12" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                    <Button x:Name="FindPrevButton" Content="&#xE70E;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="11" Click="FindPrev_Click" ToolTip="Anterior (Shift+Enter)" />
                    <Button x:Name="FindNextButton" Content="&#xE70D;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="11" Click="FindNext_Click" ToolTip="Seguinte (Enter)" />
                    <Button x:Name="FindCloseButton" Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            FontSize="10" Click="FindClose_Click" ToolTip="Fechar (Esc)" />
                </StackPanel>
            </Border>

            <!-- Ecrã dividido: contorno íris da metade ativa (por cima da página, que é uma janela própria) -->
            <Border x:Name="SplitFocusRing" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{DynamicResource IrisBrush}" BorderThickness="2"
                    CornerRadius="4" Opacity="0.85" />

            <!-- Ecrã dividido: faixa que acende ao arrastar uma aba até à margem direita (lado a lado) ou inferior (empilhado) -->
            <Border x:Name="SplitDropHint" Grid.Row="2" Panel.ZIndex="52" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource IrisBrush}" Opacity="0.4" CornerRadius="6" />

            <!-- Aviso do modo foco -->
            <Border x:Name="FocusToast" Grid.Row="2" Panel.ZIndex="50" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,18,0,0" CornerRadius="16" Padding="16,8" Background="{DynamicResource ToastBrush}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource IrisBrush}" BorderThickness="1" Opacity="0">
                <TextBlock FontSize="13" Foreground="{DynamicResource TextBrush}">
                    Modo foco — leve o rato ao topo para as barras; <Bold>F11</Bold> para voltar
                </TextBlock>
            </Border>

            <!-- Para onde vai o link debaixo do rato -->
            <Border x:Name="LinkStatusBubble" Grid.Row="2" Panel.ZIndex="50" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12,0,0,12" CornerRadius="8" Padding="10,4" MaxWidth="720" IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="LinkStatusText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Aviso genérico (copiado, guardado, ...) -->
            <Border x:Name="Toast" Grid.Row="2" Panel.ZIndex="55" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" CornerRadius="18" Padding="18,9" Background="{DynamicResource ToastBrush}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,10,0"
                               Foreground="{DynamicResource IrisBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="560" />
                    <!-- «Anular», «Abrir», «Mostrar na pasta»: preenchidos em ShowToast -->
                    <StackPanel x:Name="ToastActions" Orientation="Horizontal" Margin="6,0,-8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Paleta de comandos -->
            <Grid x:Name="PaletteOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Rectangle Fill="{DynamicResource ScrimBrush}" MouseLeftButtonDown="PaletteBackdrop_MouseLeftButtonDown" />
                <Border x:Name="PaletteCard" Width="680" VerticalAlignment="Top" Margin="0,92,0,0" CornerRadius="22"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource IrisBrush}"
                        BorderThickness="1.5" RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PaletteScale" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.6" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Height="62" Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBox x:Name="PaletteInput" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="18"
                                     TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                            <TextBlock x:Name="PalettePlaceholder" Grid.Column="1" IsHitTestVisible="False" FontSize="18"
                                       Margin="2,0,0,1" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"
                                       Text="Escreva um comando, o nome de uma aba ou um site…" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource FieldBorderBrush}" />
                        <ListBox x:Name="PaletteList" Margin="8,8,8,4" MaxHeight="452" Focusable="False"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PaletteItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                        <TextBlock Margin="22,4,22,14" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                                   Text="↑ ↓ navegar   ·   Enter executar   ·   Esc fechar" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
