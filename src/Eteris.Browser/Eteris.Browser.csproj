<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Marca: gerado por build/brand/make-icon.ps1 (exe, janelas, barra de tarefas, atalhos). -->
    <ApplicationIcon>Assets\eteris.ico</ApplicationIcon>
    <!-- Windows 10/11 declarado ao Chromium (app.manifest; E2 do plano de desempenho da 0.2.14). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>Eteris.Browser</AssemblyName>
    <RootNamespace>Eteris.Browser</RootNamespace>
    <Version>0.2.13</Version>
    <Product>Éteris</Product>
    <StartupObject>Eteris.Browser.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Escudo: crate Rust (adblock-rust) compilado como eteris_shields.dll e distribuído junto do exe. -->
  <PropertyGroup>
    <ShieldsDir>$(MSBuildThisFileDirectory)..\Eteris.Shields\</ShieldsDir>
    <CargoExe Condition="'$(CargoExe)' == '' And Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">$(USERPROFILE)\.cargo\bin\cargo.exe</CargoExe>
    <CargoExe Condition="'$(CargoExe)' == ''">cargo</CargoExe>
    <!-- As mensagens de panic! das crates do registo levam o caminho do CARGO_HOME (por omissão %USERPROFILE%\.cargo,
         com o nome do utilizador): a opção remap-path-prefix do rustc troca-o por /cargo no eteris_shields.dll. -->
    <CargoHome Condition="'$(CargoHome)' == '' And '$(CARGO_HOME)' != ''">$(CARGO_HOME)</CargoHome>
    <CargoHome Condition="'$(CargoHome)' == ''">$(USERPROFILE)\.cargo</CargoHome>
  </PropertyGroup>

  <!-- O CARGO_ENCODED_RUSTFLAGS leva uma só opção (sem o separador 0x1F, aceita espaços no caminho) e ganha a um RUSTFLAGS
       do ambiente; mudar as opções faz o cargo recompilar as dependências uma vez, e um cargo build à mão sem elas também. -->
  <Target Name="BuildShields" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(CargoExe)&quot; build --release --quiet --manifest-path &quot;$(ShieldsDir)Cargo.toml&quot;"
          EnvironmentVariables="CARGO_ENCODED_RUSTFLAGS=--remap-path-prefix=$(CargoHome)=/cargo"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Browser\newtab.html" />
    <EmbeddedResource Include="Browser\Wallpapers\coast.jpg" />
    <EmbeddedResource Include="Browser\Wallpapers\mountains.jpg" />
    <EmbeddedResource Include="Browser\Wallpapers\coast-live.webm" />
    <EmbeddedResource Include="Browser\error.html" />
    <EmbeddedResource Include="Browser\history.html" />
    <EmbeddedResource Include="Browser\settings.html" />
    <EmbeddedResource Include="Browser\bookmarks.html" />
    <EmbeddedResource Include="Browser\welcome.html" />
    <EmbeddedResource Include="Browser\whatsnew.html" />
    <EmbeddedResource Include="Browser\privacy.html" />
    <EmbeddedResource Include="Browser\passwords.html" />
    <EmbeddedResource Include="Browser\autofill.html" />
    <EmbeddedResource Include="Vault\Scripts\cofre.js" LogicalName="Eteris.Browser.Vault.cofre.js" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Eteris.Browser.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="Shields\trackers.txt" />
    <!-- Mapa domínio → empresa do Observatório do site: escrito pelo projeto, sem dados de terceiros. -->
    <EmbeddedResource Include="Shields\resources\owners.json" LogicalName="Eteris.Browser.Shields.owners.json" />
    <EmbeddedResource Include="Browser\Vendor\readability\Readability.js" LogicalName="Eteris.Browser.Readability.js" />
    <EmbeddedResource Include="Browser\Vendor\readability\Readability-readerable.js" LogicalName="Eteris.Browser.Readability-readerable.js" />
    <None Include="$(ShieldsDir)target\release\eteris_shields.dll" Link="eteris_shields.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="Shields\lists\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Gerado por build/scriptlets a partir do uBlock Origin; só muda com uma nova versão do Éteris. -->
    <None Include="Shields\resources\scriptlets.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Licença do Éteris e textos completos das licenças de terceiros: vão sempre com a instalação. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\licenses\**\*" LinkBase="licenses" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eteris.Browser.Tests" />
  </ItemGroup>

  <!-- Sincronização (docs/sincronizacao.md): biblioteca .NET sem WPF, partilhável com a versão Android. -->
  <ItemGroup>
    <ProjectReference Include="..\Eteris.Sync\Eteris.Sync.csproj" />
  </ItemGroup>

  <!-- Motor com codecs da plataforma (docs/motor.md, «Motor com codecs»): quando existe a compilação própria da CEF
       156.0.15 (mesmo commit da do NuGet, por isso o CefSharp 156.0.150 não muda), o runtime COMPLETO (libcef, paks,
       icudtl, snapshot V8, chrome_elf, d3dcompiler, dxcompiler, swiftshader, vulkan, locales) substitui o do NuGet na
       saída, depois de compilar e de publicar. Os avisos de licença dela vão para licenses\cef-codecs, com o
       manifest.json (proveniência da compilação, e a marca que Tabs/PlatformCodecs.cs procura para saber que o motor
       pode ter codecs). Sem a pasta (build/cef-codecs/out/runtime com libcef.dll e manifest.json), nada muda.
       O bootstrap.exe/bootstrapc.exe (arranque dos processos pelo sandbox do Chromium, docs/sandbox.md passo D) fica fora
       desta cópia; com -p:EterisSandbox=true (em baixo) o bootstrap.exe vai renomeado para Eteris.Browser.exe. -->
  <!-- CefSharp com o patch v2 do sandbox (build/cefsharp, docs/sandbox.md passo D): só quando se passa o feed local
       produzido por build/cefsharp/pack-local.ps1 (-p:EterisCefSharpFeed=<pasta> -p:EterisCefSharpN=<n>). Sem ele, o
       CefSharp oficial 156.0.150 e nada muda (o ponteiro do sandbox é ignorado: CefConfigurator.SandboxSupported). -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources Condition="'$(EterisCefSharpFeed)' != ''">$(EterisCefSharpFeed)</RestoreAdditionalProjectSources>
    <DefineConstants Condition="'$(EterisCefSharpFeed)' != ''">$(DefineConstants);ETERIS_CEFSHARP_SANDBOX</DefineConstants>
  </PropertyGroup>
  <Target Name="EterisCefSharpFeedCheck" BeforeTargets="CollectPackageReferences" Condition="'$(EterisCefSharpFeed)' != '' And '$(EterisCefSharpN)' == ''">
    <Error Text="EterisCefSharpFeed sem EterisCefSharpN (o N de 156.0.150-eteris.N, ver build/cefsharp/README.md)" />
  </Target>

  <PropertyGroup>
    <EterisCefRuntime>$(MSBuildThisFileDirectory)..\..\build\cef-codecs\out\runtime</EterisCefRuntime>
    <EterisCefRuntimeOn Condition="Exists('$(EterisCefRuntime)\libcef.dll') And Exists('$(EterisCefRuntime)\manifest.json')">true</EterisCefRuntimeOn>
  </PropertyGroup>

  <Target Name="EterisCefRuntimeItems" Condition="'$(EterisCefRuntimeOn)' == 'true'">
    <ItemGroup>
      <_EterisCefFile Include="$(EterisCefRuntime)\**\*" Exclude="$(EterisCefRuntime)\manifest.json;$(EterisCefRuntime)\licenses\**;$(EterisCefRuntime)\bootstrap.exe;$(EterisCefRuntime)\bootstrapc.exe" />
      <_EterisCefLicense Include="$(EterisCefRuntime)\licenses\**\*;$(EterisCefRuntime)\manifest.json" />
    </ItemGroup>
  </Target>

  <Target Name="EterisCefRuntimeAfterBuild" AfterTargets="Build" DependsOnTargets="EterisCefRuntimeItems"
          Condition="'$(EterisCefRuntimeOn)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_EterisCefFile)" DestinationFiles="@(_EterisCefFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_EterisCefLicense)" DestinationFiles="@(_EterisCefLicense->'$(OutDir)licenses\cef-codecs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="EterisCefRuntimeAfterPublish" AfterTargets="Publish" DependsOnTargets="EterisCefRuntimeItems"
          Condition="'$(EterisCefRuntimeOn)' == 'true'">
    <Copy SourceFiles="@(_EterisCefFile)" DestinationFiles="@(_EterisCefFile->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_EterisCefLicense)" DestinationFiles="@(_EterisCefLicense->'$(PublishDir)licenses\cef-codecs\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="156.0.150" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Sandbox dos processos das páginas (docs/sandbox.md, passo D6), só com -p:EterisSandbox=true (mais o feed do
       CefSharp, em cima, e a DLL cliente de build/sandbox/client/build.cmd). Nomes (opção B):
         Eteris.Browser.exe = bootstrap.exe do runtime do motor (o ponto de entrada de todos os processos);
         Eteris.Browser.dll = DLL cliente nativa (filhos: CefExecuteProcess; principal: .NET pela hostfxr);
         Eteris.App.dll/.exe = este projeto (.NET; o Eteris.App.exe arranca sem sandbox, para desenvolvimento).
       O Velopack, os atalhos, a lista de saltos, a associação de navegador e a instância única continuam com o
       Eteris.Browser.exe. Sem a opção, nada muda. -->
  <PropertyGroup Condition="'$(EterisSandbox)' == 'true'">
    <AssemblyName>Eteris.App</AssemblyName>
    <EterisSandboxClientDll Condition="'$(EterisSandboxClientDll)' == ''">$(MSBuildThisFileDirectory)..\..\build\sandbox\client\out\Release\Eteris.Browser.dll</EterisSandboxClientDll>
  </PropertyGroup>

  <Target Name="EterisSandboxCheck" BeforeTargets="CollectPackageReferences;Build" Condition="'$(EterisSandbox)' == 'true'">
    <Error Condition="'$(EterisCefSharpFeed)' == ''" Text="EterisSandbox precisa do CefSharp com o patch v2: -p:EterisCefSharpFeed=... -p:EterisCefSharpN=... (build/cefsharp/README.md)" />
    <Error Condition="'$(EterisCefRuntimeOn)' != 'true' Or !Exists('$(EterisCefRuntime)\bootstrap.exe')" Text="EterisSandbox precisa do runtime do motor com o bootstrap.exe em $(EterisCefRuntime) (build/cef-codecs)" />
    <Error Condition="!Exists('$(EterisSandboxClientDll)')" Text="EterisSandbox: falta a DLL cliente $(EterisSandboxClientDll) (build/sandbox/client/build.cmd)" />
    <!-- A DLL cliente arranca o .NET pela hostfxr.dll da pasta do exe: só com o .NET dentro da publicação. -->
    <Error Condition="'$(SelfContained)' != 'true'" Text="EterisSandbox precisa de SelfContained=true (a DLL cliente arranca o .NET pela hostfxr.dll da pasta do programa)" />
    <!-- DLL cliente da mesma compilação do motor que o runtime (versão da CEF gravada nela contra o manifest.json),
         importações diretas só do KERNEL32, só as duas exportações e sem o instalador embutido da CEF. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\sandbox\verify-client.ps1&quot; -Dll &quot;$(EterisSandboxClientDll)&quot; -Runtime &quot;$(EterisCefRuntime)&quot;" />
  </Target>

  <ItemGroup Condition="'$(EterisSandbox)' == 'true'">
    <_EterisSandboxEntry Include="$(EterisCefRuntime)\bootstrap.exe" TargetName="Eteris.Browser.exe" />
    <_EterisSandboxEntry Include="$(EterisSandboxClientDll)" TargetName="Eteris.Browser.dll" />
  </ItemGroup>

  <Target Name="EterisSandboxAfterBuild" AfterTargets="Build" Condition="'$(EterisSandbox)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_EterisSandboxEntry)" DestinationFiles="@(_EterisSandboxEntry->'$(OutDir)%(TargetName)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Na publicação saem o processo filho .NET do CefSharp (os filhos são o Eteris.Browser.exe, também sem
       sandbox por diagnóstico) e o apphost Eteris.App.exe (sem o bootstrap precisaria desse processo filho). -->
  <Target Name="EterisSandboxAfterPublish" AfterTargets="Publish" Condition="'$(EterisSandbox)' == 'true'">
    <Copy SourceFiles="@(_EterisSandboxEntry)" DestinationFiles="@(_EterisSandboxEntry->'$(PublishDir)%(TargetName)')" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe;$(PublishDir)CefSharp.BrowserSubprocess.exe;$(PublishDir)CefSharp.BrowserSubprocess.dll;$(PublishDir)CefSharp.BrowserSubprocess.Core.dll;$(PublishDir)CefSharp.BrowserSubprocess.runtimeconfig.json" />
    <!-- Ícone e versão do Éteris no bootstrap («CEF Bootstrap Application» por omissão); precisa do rc.exe do SDK. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\sandbox\brand-bootstrap.ps1&quot; -Exe &quot;$(PublishDir)Eteris.Browser.exe&quot; -Version $(Version)" />
  </Target>

  <!-- Ver EterisCefSharpFeed em cima: a mesma referência, na versão do feed local. -->
  <ItemGroup Condition="'$(EterisCefSharpFeed)' != ''">
    <PackageReference Update="CefSharp.Wpf.NETCore" Version="156.0.150-eteris.$(EterisCefSharpN)" />
  </ItemGroup>

</Project>
