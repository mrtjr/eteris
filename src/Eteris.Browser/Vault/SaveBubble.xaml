<!-- A bolha «Guardar a palavra-passe?» (docs/palavras-passe.md, C4): presa à barra de endereço, a sair do cadeado e por
     cima da linha entre as barras e a página (nada da página chega lá). A origem é a do processo do navegador. Abre sem
     roubar o foco do teclado à página. -->
<UserControl x:Class="Eteris.Browser.Vault.SaveBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Width="356"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}"
             AutomationProperties.Name="Guardar palavra-passe">
    <Grid>
        <!-- O bico aponta para o cadeado: a bolha vem da barra de endereço, não da página. -->
        <Path x:Name="Beak" Data="M0,9 L9,0 L18,9 Z" Width="18" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="14,0,0,0" Fill="{DynamicResource SurfaceRaisedBrush}" Stroke="{DynamicResource FieldBorderBrush}" StrokeThickness="1" />
        <Border Margin="0,8,0,0" CornerRadius="16" Padding="18,14,18,16" BorderThickness="1"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource FieldBorderBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                            Margin="8,-4,-8,0" VerticalAlignment="Top" FontSize="10" Content="&#xE8BB;" ToolTip="Fechar (Esc)"
                            AutomationProperties.Name="Fechar" />
                    <Grid Width="32" Height="32" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource IrisBrush}" />
                        <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="Question" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="Utilizador" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,4" />
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}" Padding="10,6">
                    <TextBox x:Name="UserBox" Style="{StaticResource BareTextBox}" FontSize="13.5"
                             AutomationProperties.Name="Utilizador" />
                </Border>

                <TextBlock Text="Palavra-passe" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4" />
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}" Padding="10,2,4,2">
                    <DockPanel>
                        <Button x:Name="EyeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                FontSize="13" Content="&#xE7B3;" ToolTip="Mostrar a palavra-passe"
                                AutomationProperties.Name="Mostrar a palavra-passe" />
                        <TextBlock x:Name="PasswordText" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Palavra-passe escondida" />
                    </DockPanel>
                </Border>

                <DockPanel Margin="0,16,0,0" LastChildFill="False">
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                            Content="&#xE712;" ToolTip="Mais opções" AutomationProperties.Name="Mais opções" />
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Guardar" Style="{StaticResource PrimaryPillButton}"
                            Margin="8,0,0,0" />
                    <Button x:Name="NotNowButton" DockPanel.Dock="Right" Content="Agora não" Style="{StaticResource PillButton}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
