<!-- O recorte ao vivo (ClipWindow.xaml.cs): uma janela pequena, sempre por cima, com um pedaço vivo de uma página. A barra
     fica numa linha própria por cima da página (a página é uma janela nativa e taparia o que o WPF desenhasse por cima);
     a margem à volta da página é a borda por onde a janela se redimensiona. -->
<Window x:Class="Eteris.Browser.ClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Recorte ao vivo — Éteris" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource FrameBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" AutomationProperties.Name="Recorte ao vivo">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="Bar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" LastChildFill="True" Cursor="SizeAll">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11"
                        Content="&#xE711;" ToolTip="Fechar" Cursor="Arrow" Margin="0,0,2,0" />
                <Button x:Name="ReloadButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12"
                        Content="&#xE72C;" ToolTip="Recarregar a cada…" Cursor="Arrow" />
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12"
                        Content="&#xE8A7;" ToolTip="Abrir a página" Cursor="Arrow" />
                <TextBlock x:Name="Caption" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Border x:Name="PageHost" Grid.Row="1" Margin="5,0,5,5" Background="{DynamicResource SurfaceBrush}" />
        </Grid>
    </Border>
</Window>
