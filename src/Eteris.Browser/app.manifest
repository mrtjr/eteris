<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto do processo principal (E2 do plano de desempenho da 0.2.14). Sem o <supportedOS> do Windows 10/11, o
     GetVersionEx devolve 6.2 e o Chromium julga-se no Windows 8 (base/win/windows_version.cc): os processos filhos levam
     os /prefetch: do intervalo antigo e os caminhos «>= WIN10» ficam desligados. O manifesto por omissão do SDK não tem
     <compatibility>. Só isso muda: o nível de execução é o mesmo do manifesto por omissão (asInvoker; sem ele o Windows
     virtualizaria o registo e os ficheiros) e a consciência de DPI fica com o WPF, como até aqui.
     Com o sandbox (-p:EterisSandbox=true), o exe principal é o bootstrap.exe do motor, que já tem o manifesto completo;
     este vale para o Eteris.App.exe (desenvolvimento) e para a publicação de recuo (-NoSandbox). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Eteris.Browser.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 (o mesmo GUID) -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>
</assembly>
