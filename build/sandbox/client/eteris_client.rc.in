// Recurso de versão da DLL cliente (CMakeLists.txt: configure_file com a versão da CEF da distribuição).
// ProductVersion = CEF_VERSION e Comments = commit da CEF: build/sandbox/verify-client.ps1 compara-os com o
// manifest.json do runtime do motor. Sem #include (o rc.exe corre sem o ambiente do VS): 0x40004 = VOS_NT_WINDOWS32,
// 0x2 = VFT_DLL.
#pragma code_page(65001)
1 VERSIONINFO
FILEVERSION @CEF_VERSION_MAJOR@,@CEF_VERSION_MINOR@,@CEF_VERSION_PATCH@,@CEF_COMMIT_NUMBER@
PRODUCTVERSION @CEF_VERSION_MAJOR@,@CEF_VERSION_MINOR@,@CEF_VERSION_PATCH@,@CEF_COMMIT_NUMBER@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Éteris"
      VALUE "FileDescription", "Éteris: arranque dos processos pelo bootstrap da CEF"
      VALUE "FileVersion", "@CEF_VERSION@"
      VALUE "InternalName", "@ETERIS_CLIENT_NAME@"
      VALUE "OriginalFilename", "@ETERIS_CLIENT_NAME@.dll"
      VALUE "ProductName", "Éteris"
      VALUE "ProductVersion", "@CEF_VERSION@"
      VALUE "LegalCopyright", "Inclui o libcef_dll_wrapper: Copyright (C) The Chromium Embedded Framework Authors (BSD-3-Clause)"
      VALUE "Comments", "cef_commit=@CEF_COMMIT_HASH@@ETERIS_CLIENT_FLAVOR@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
