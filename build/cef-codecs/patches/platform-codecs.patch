+#if BUILDFLAG(PLATFORM_PROPRIETARY_DECODERS_ONLY)
+// Without an FFmpeg AAC decoder, avformat_find_stream_info() cannot fill the
+// sample rate and channel count of a raw ADTS ("aac" demuxer) stream: the AAC
+// parser deliberately leaves them to the decoder (because of implicit SBR), so
+// the stream would have no valid AudioDecoderConfig and packets would get
+// neither durations nor timestamps. avformat_open_input() leaves the I/O
+// context on the first ADTS frame, so read its header here, before
+// avformat_find_stream_info() copies the codec parameters to the internal
+// codec context, and fill the core sample rate, channel count, profile, frame
+// size and a two-byte AudioSpecificConfig. The platform (Media Foundation)
+// decoder reports the real output format (e.g. doubled by SBR) when decoding.
+void FillAdtsCodecParameters(AVFormatContext* format_context) {
+  if (!format_context->iformat || !format_context->iformat->name ||
+      !format_context->pb ||
+      std::string_view(format_context->iformat->name) != "aac") {
+    return;
+  }
+
+  for (AVStream* stream : AVFormatContextToSpan(format_context)) {
+    AVCodecParameters* codec_parameters = stream->codecpar;
+    if (codec_parameters->codec_id != AV_CODEC_ID_AAC ||
+        codec_parameters->extradata_size > 0 ||
+        (codec_parameters->sample_rate > 0 &&
+         codec_parameters->ch_layout.nb_channels > 0)) {
+      continue;
+    }
+
+    AVIOContext* pb = format_context->pb;
+    const int64_t position = avio_tell(pb);
+    if (position < 0) {
+      return;
+    }
+    std::array<uint8_t, kADTSHeaderSizeWithCrc> header_bytes = {};
+    const int bytes_read =
+        avio_read(pb, header_bytes.data(), header_bytes.size());
+    if (avio_seek(pb, position, SEEK_SET) < 0) {
+      DLOG(ERROR) << __func__ << ": failed to rewind to the first ADTS frame";
+      return;
+    }
+    if (bytes_read < kADTSHeaderMinSize) {
+      return;
+    }
+
+    const std::optional<ADTSStreamParser::Header> header =
+        ADTSStreamParser::ParseHeader(
+            base::span(header_bytes).first(static_cast<size_t>(bytes_read)));
+    // Channel configuration 0 (layout in a program_config_element) cannot be
+    // described without decoding; leave the stream unsupported.
+    if (!header || header->channel_layout == CHANNEL_LAYOUT_NONE ||
+        header->sample_rate <= 0 || header->extra_data.size() != 2) {
+      return;
+    }
+
+    codec_parameters->sample_rate = header->sample_rate;
+    av_channel_layout_uninit(&codec_parameters->ch_layout);
+    av_channel_layout_default(
+        &codec_parameters->ch_layout,
+        ChannelLayoutToChannelCount(header->channel_layout));
+    // audioObjectType (first five bits of the AudioSpecificConfig) minus one,
+    // which is how FFmpeg reports AAC profiles.
+    codec_parameters->profile = (header->extra_data[0] >> 3) - 1;
+    // Lets FFmpeg compute packet durations and interpolate timestamps.
+    codec_parameters->frame_size = kSamplesPerAACFrame;
+
+    uint8_t* extradata = static_cast<uint8_t*>(
+        av_mallocz(header->extra_data.size() + AV_INPUT_BUFFER_PADDING_SIZE));
+    if (!extradata) {
+      return;
+    }
+    // SAFETY: `extradata` was just allocated with room for
+    // `header->extra_data.size()` bytes plus FFmpeg's padding.
+    UNSAFE_BUFFERS(base::span(extradata, header->extra_data.size()))
+        .copy_from(header->extra_data);
+    codec_parameters->extradata = extradata;
+    codec_parameters->extradata_size =
+        static_cast<int>(header->extra_data.size());
+    return;
+  }
+}
+#endif  // BUILDFLAG(PLATFORM_PROPRIETARY_DECODERS_ONLY)
+
+int FindStreamInfo(AVFormatContext* format_context) {
+#if BUILDFLAG(PLATFORM_PROPRIETARY_DECODERS_ONLY)
+  FillAdtsCodecParameters(format_context);
+#endif  // BUILDFLAG(PLATFORM_PROPRIETARY_DECODERS_ONLY)
+  return avformat_find_stream_info(format_context, nullptr);
+}
