<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ferramenta da chave das atualizações (docs/atualizacoes.md): gera a chave, assina e verifica o releases.win.json.
       Uso (linha de comandos completa no Program.cs): dotnet run, com o projeto build/sign, em Release, e um dos
       comandos new-key, public, sign ou verify. Verifica com o mesmo UpdateSignature.cs que o Éteris usa (aqui sem recurso embutido: as chaves vêm do ficheiro). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Eteris.Sign</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Eteris.Browser\Updates\UpdateSignature.cs" Link="UpdateSignature.cs" />
  </ItemGroup>

</Project>
